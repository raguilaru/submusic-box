<Project>
  <!--
  Build output must live on a local NTFS volume: UWP app registration (F5
  loose-layout deploy) fails from the Parallels network share with
  DEP0700 / 0x80073D1F, and network I/O slows MSBuild. Sources stay on the
  share; all bin/obj go under %LOCALAPPDATA%\BoxSubMusicBuild on the Windows
  build machine.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\BoxSubMusicBuild\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\BoxSubMusicBuild\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
