<Page
    x:Class="BoxSubMusic.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
    Slice 04 (requirements §5): the application shell. Persistent collapsible
    left nav in the fixed order Search, Home, Artists, Albums, Songs,
    Playlists, then Settings and Account after a separator (moved out of
    PaneFooter 2026-07-14 — see the note below). The built-in NavigationView
    settings item is disabled because its gear glyph is Segoe MDL2 — mixing
    icon sets violates §13.3 (Fluent UI System Icons only).
    -->
    <Page.Resources>
        <!-- 10-ft sizing for the pane items (§2/§13.2): with the automatic
             200% scale disabled (2026-07-14), the NavigationView's system
             defaults (40 epx rows, ~14 epx text) read too small on a TV.
             Implicit style: setters layer on top of the default template. -->
        <Style TargetType="NavigationViewItem">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
    </Page.Resources>

    <!-- Slice 11 (§10): the expanded queue is a full-screen overlay layered
         over the whole shell — nav pane and bar included — so the shell root
         is a Grid. While the overlay is open the NavigationView is disabled,
         which keeps XY focus trapped inside the overlay (nothing behind it
         is focusable). Y toggles the overlay from anywhere in the shell
         (ShellRoot_KeyDown); B closes it (OnBackRequested). -->
    <Grid x:Name="ShellRoot" KeyDown="ShellRoot_KeyDown">

    <NavigationView
        x:Name="NavView"
        KeyDown="NavView_KeyDown"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        SelectionChanged="NavView_SelectionChanged"
        ItemInvoked="NavView_ItemInvoked"
        PaneOpening="NavView_PaneOpening"
        PaneClosing="NavView_PaneClosing">

        <!-- Global-shortcut hint (console checkpoint #6 feedback: visible
             controller labels). Plain non-focusable text, so the PaneFooter
             focus dead zone (2026-07-14) is irrelevant here; hidden while
             the pane is collapsed because the strip would clip. -->
        <NavigationView.PaneFooter>
            <StackPanel x:Name="NavHintPanel" Margin="16,0,8,12" Spacing="2">
                <TextBlock
                    Text="Press LB for this menu, RB for the content."
                    FontSize="15"
                    Opacity="0.6"
                    FontStyle="Italic"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="Press Y for the queue during playback."
                    FontSize="15"
                    Opacity="0.6"
                    FontStyle="Italic"
                    TextWrapping="Wrap" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Search" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF690;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF481;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ArtistsNavItem" Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF5A9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AlbumsNavItem" Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE010;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE855;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PlaylistsNavItem" Content="Playlists" Tag="playlists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF4EE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- §5: Settings, then Account, as the bottom of the nav order.
                 These lived in PaneFooter until 2026-07-14, but the OS
                 NavigationView's footer is a separate XY focus region the
                 gamepad could not reach (three interception approaches
                 failed on console). As ordinary menu items after a
                 separator, focus, selection, and invoke all work natively.
                 The trade-off — bottom of the list instead of pinned to the
                 pane's bottom edge — is a recorded §16 decision. -->
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF6AA;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AccountNavItem" Content="Account" Tag="account">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE929;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Slice 10 (§10): the now-playing bar owns its own Auto row below
             the content frame — visually floating, but never overlapping
             page content (list bottoms stay reachable). It collapses to
             zero height until the first Play action. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Frame x:Name="ContentFrame" />
            <!-- KeyDown: Up from a bar control must land in the page content
                 above, not in the nav pane (console checkpoint #4 finding —
                 the XY engine preferred the pane's bottom items). -->
            <controls:NowPlayingBar
                x:Name="NowPlaying"
                Grid.Row="1"
                KeyDown="NowPlaying_KeyDown" />
        </Grid>
    </NavigationView>

    <controls:ExpandedQueueView x:Name="QueueOverlay" />

    </Grid>
</Page>
