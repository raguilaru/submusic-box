<Page
    x:Class="BoxSubMusic.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
    Slice 04 (requirements §5): the application shell. Persistent collapsible
    left nav in the fixed order Search, Home, Artists, Albums, Songs,
    Playlists, then Settings and Account after a separator (moved out of
    PaneFooter 2026-07-14 — see the note below). The built-in NavigationView
    settings item is disabled because its gear glyph is Segoe MDL2 — mixing
    icon sets violates §13.3 (Fluent UI System Icons only).
    -->
    <Page.Resources>
        <!-- 10-ft sizing for the pane items (§2/§13.2): with the automatic
             200% scale disabled (2026-07-14), the NavigationView's system
             defaults (40 epx rows, ~14 epx text) read too small on a TV.
             Implicit style: setters layer on top of the default template. -->
        <Style TargetType="NavigationViewItem">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
    </Page.Resources>

    <!-- Slice 11 (§10): the expanded queue is a full-screen overlay layered
         over the whole shell — nav pane and bar included — so the shell root
         is a Grid. While the overlay is open the NavigationView is disabled,
         which keeps XY focus trapped inside the overlay (nothing behind it
         is focusable). Y toggles the overlay from anywhere in the shell
         (ShellRoot_KeyDown); B closes it (OnBackRequested). -->
    <!-- TV-safe inset (checkpoint #7 finding 2026-07-18: the nav pane was
         clipped by TV overscan). The app opted out of the system-reserved
         safe border in 2026-07-14 (§2/§16: edge-to-edge canvas, app-side
         padding) — this is that promised padding for the shell. 32/20 is
         chosen so the pane's leftmost interactive pixel (item icons at
         ~16 epx into the pane) lands at the 48-epx TV-safe line, and
         top/bottom content clears the 27-epx line; the page background
         still paints the full canvas, so overscan crops only background. -->
    <Grid x:Name="ShellRoot" KeyDown="ShellRoot_KeyDown" Padding="32,20,32,20">

    <!-- Rounded pane backdrop (checkpoint #8 request, 2026-07-19): the OS
         NavigationView paints its pane background as a hard-edged rectangle,
         so its pane brushes are overridden to Transparent (App.xaml theme
         dictionaries) and this Border supplies the visual instead — radius
         12, matching the now-playing bar's floating look. Width follows the
         pane state (280 open / 48 compact) from PaneOpening/PaneClosing. -->
    <Border
        x:Name="PaneBackdrop"
        HorizontalAlignment="Left"
        Width="280"
        CornerRadius="12"
        Background="{ThemeResource SystemControlChromeMediumLowAcrylicElementMediumBrush}" />

    <NavigationView
        x:Name="NavView"
        KeyDown="NavView_KeyDown"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        SelectionChanged="NavView_SelectionChanged"
        ItemInvoked="NavView_ItemInvoked"
        PaneOpening="NavView_PaneOpening"
        PaneClosing="NavView_PaneClosing">

        <!-- Global-shortcut hints as monochrome button badges (checkpoint #7
             request, 2026-07-18). Non-focusable decoration, so the PaneFooter
             focus dead zone (2026-07-14) is irrelevant here; hidden while
             the pane is collapsed because the strip would clip. LB/RB cycle
             the three shell regions (decision 2026-07-18). -->
        <NavigationView.PaneFooter>
            <StackPanel x:Name="NavHintPanel" Margin="16,0,8,12" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                    <controls:ControllerGlyph Label="LB" />
                    <controls:ControllerGlyph Label="RB" />
                    <TextBlock
                        Text="Menu · content · playback"
                        FontSize="15"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                    <controls:ControllerGlyph Label="Y" />
                    <TextBlock
                        Text="Queue"
                        FontSize="15"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneFooter>

        <NavigationView.MenuItems>
            <!-- Pane toggle as an ordinary first menu item (checkpoint #8
                 request, 2026-07-19): replaces the built-in Segoe MDL2
                 hamburger (hidden above — it was also a §13.3 icon-set
                 violation) with the modern Fluent panel-contract/expand pair
                 (E8B6/E8BA, cmap-verified; the glyph swaps with the pane
                 state). A menu item — not a floated button and not
                 PaneHeader — because ordinary items are the pattern the
                 gamepad focus engine is proven to handle (the 2026-07-14
                 PaneFooter lesson); SelectsOnInvoked=False keeps it out of
                 the selection model, and ItemInvoked toggles the pane. -->
            <NavigationViewItem
                x:Name="PaneToggleItem"
                SelectsOnInvoked="False"
                AutomationProperties.Name="Expand or collapse the menu">
                <NavigationViewItem.Icon>
                    <FontIcon x:Name="PaneToggleIcon" FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE8B6;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="Search" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF690;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF481;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ArtistsNavItem" Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF5A9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AlbumsNavItem" Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE010;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE855;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PlaylistsNavItem" Content="Playlists" Tag="playlists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF4EE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- §5: Settings, then Account, as the bottom of the nav order.
                 These lived in PaneFooter until 2026-07-14, but the OS
                 NavigationView's footer is a separate XY focus region the
                 gamepad could not reach (three interception approaches
                 failed on console). As ordinary menu items after a
                 separator, focus, selection, and invoke all work natively.
                 The trade-off — bottom of the list instead of pinned to the
                 pane's bottom edge — is a recorded §16 decision. -->
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xF6AA;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AccountNavItem" Content="Account" Tag="account">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Glyph="&#xE929;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Slice 10 (§10): the now-playing bar owns its own Auto row below
             the content frame — visually floating, but never overlapping
             page content (list bottoms stay reachable). It collapses to
             zero height until the first Play action. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Frame x:Name="ContentFrame" />
            <!-- KeyDown: Up from a bar control must land in the page content
                 above, not in the nav pane (console checkpoint #4 finding —
                 the XY engine preferred the pane's bottom items). -->
            <controls:NowPlayingBar
                x:Name="NowPlaying"
                Grid.Row="1"
                KeyDown="NowPlaying_KeyDown" />
        </Grid>
    </NavigationView>

    <controls:ExpandedQueueView x:Name="QueueOverlay" />

    </Grid>
</Page>
