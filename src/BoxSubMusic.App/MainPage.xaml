<Page
    x:Class="BoxSubMusic.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
    Slice 01 spike: prove controller-first focus navigation in the shell.
    Nav order per requirements §5; real content hosting arrives in Slice 04.
    -->
    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Search" Tag="search">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Find" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home" IsSelected="True">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="MusicInfo" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Playlists" Tag="playlists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- OS NavigationView has no FooterMenuItems (WinUI 2 only); the
             built-in Settings item plus PaneFooter covers requirement §5's
             bottom area for the spike. Revisit layout in Slice 04. -->
        <NavigationView.PaneFooter>
            <NavigationViewItem Content="Account" Tag="account">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.PaneFooter>

        <Grid Padding="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="SectionTitle"
                Grid.Row="0"
                Text="Home"
                FontSize="48"
                FontWeight="SemiBold" />

            <TextBlock
                Grid.Row="1"
                Margin="0,16,0,0"
                FontSize="24"
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Focus navigation spike. Move focus with the D-pad or left stick: through the left menu, into these buttons, and back. Press A to activate." />

            <!-- XYFocus makes arrow keys behave like the D-pad between buttons;
                 gamepad XY navigation is automatic, keyboard needs opt-in. -->
            <StackPanel
                Grid.Row="2"
                Margin="0,40,0,0"
                Orientation="Horizontal"
                Spacing="24"
                XYFocusKeyboardNavigation="Enabled">
                <Button
                    x:Name="PlayButton"
                    Content="&#xE768;  Play"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="24"
                    Padding="32,16"
                    Click="TestButton_Click" />
                <Button
                    Content="&#xE8B1;  Shuffle"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="24"
                    Padding="32,16"
                    Click="TestButton_Click" />
                <Button
                    Content="&#xE8A9;  View"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="24"
                    Padding="32,16"
                    Click="TestButton_Click" />
            </StackPanel>

            <TextBlock
                x:Name="ActivationLog"
                Grid.Row="3"
                Margin="0,40,0,0"
                FontSize="20"
                Opacity="0.5"
                Text="" />
        </Grid>
    </NavigationView>
</Page>
