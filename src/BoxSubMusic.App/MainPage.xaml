<Page
    x:Class="BoxSubMusic.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
    Slice 04 (requirements §5): the application shell. Persistent collapsible
    left nav in the fixed order Search, Home, Artists, Albums, Songs,
    Playlists; Settings and Account live in the bottom pane area. The built-in
    NavigationView settings item is disabled because its gear glyph is Segoe
    MDL2 — mixing icon sets violates §13.3 (Fluent UI System Icons only).
    -->
    <NavigationView
        x:Name="NavView"
        KeyDown="NavView_KeyDown"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Search" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF690;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF481;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ArtistsNavItem" Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF5A9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AlbumsNavItem" Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE010;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE855;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PlaylistsNavItem" Content="Playlists" Tag="playlists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF4EE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- §5: Settings, then account/server info, in the bottom area. The
             OS NavigationView has no FooterMenuItems, so these are manually
             invoked footer items (Tapped for pointer, KeyDown for gamepad A
             and keyboard Enter/Space). -->
        <NavigationView.PaneFooter>
            <StackPanel>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="Settings"
                    Tag="settings"
                    Tapped="FooterItem_Tapped"
                    KeyDown="FooterItem_KeyDown">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF6AA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AccountNavItem"
                    Content="Account"
                    Tag="account"
                    Tapped="FooterItem_Tapped"
                    KeyDown="FooterItem_KeyDown">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE929;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </StackPanel>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
