<Page
    x:Class="BoxSubMusic.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource RetroPageBackgroundBrush}">

    <!--
    Slice 04 (requirements §5): the application shell. Persistent collapsible
    left nav in the fixed order Search, Home, Artists, Albums, Songs,
    Playlists, Favorites, then Settings and Account after a separator (moved out of
    PaneFooter 2026-07-14 — see the note below). The built-in NavigationView
    settings item is disabled because its gear glyph is Segoe MDL2 — mixing
    icon sets violates §13.3 (Fluent UI System Icons only).
    -->
    <Page.Resources>
        <!-- 10-ft sizing for the pane items (§2/§13.2): with the automatic
             200% scale disabled (2026-07-14), the NavigationView's system
             defaults (40 epx rows, ~14 epx text) read too small on a TV.
             Implicit style: setters layer on top of the default template. -->
        <!-- Label vertical centering (2026-07-19): VerticalContentAlignment
             centers the label's line box against the icon. An earlier round
             also overrode the item's ContentTemplate to add
             TextLineBounds="Tight" (to kill the line box's descender slack) —
             but that setter blanked the icons on device (overriding a
             NavigationViewItem's ContentTemplate disrupts the presenter's
             item hosting), so it was reverted. The residual descender offset
             is minor; correcting it needs a safer technique (a retemplate,
             not a bare ContentTemplate swap) and is deferred. -->
        <Style TargetType="NavigationViewItem">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!-- Slice 11 (§10): the expanded queue is a full-screen overlay layered
         over the whole shell — nav pane and bar included — so the shell root
         is a Grid. While the overlay is open the NavigationView is disabled,
         which keeps XY focus trapped inside the overlay (nothing behind it
         is focusable). Y toggles the overlay from anywhere in the shell
         (ShellRoot_KeyDown); B closes it (OnBackRequested). -->
    <!-- TV-safe inset (checkpoint #7 finding 2026-07-18: the nav pane was
         clipped by TV overscan). The app opted out of the system-reserved
         safe border in 2026-07-14 (§2/§16: edge-to-edge canvas, app-side
         padding) — this is that promised padding for the shell. 32/20 is
         chosen so the pane's leftmost interactive pixel (item icons at
         ~16 epx into the pane) lands at the 48-epx TV-safe line, and
         top/bottom content clears the 27-epx line; the page background
         still paints the full canvas, so overscan crops only background. -->
    <Grid x:Name="ShellRoot" KeyDown="ShellRoot_KeyDown" Padding="32,20,32,20">

    <!-- Ambient record grooves (light-theme round, 2026-07-27, §13.2). The
         light half read as a large empty field, most visibly on sparse pages
         (Settings, Account, an empty search). The logo's record peeking out
         of its sleeve becomes a watermark: concentric groove rings centred
         off the right edge, so arcs sweep the right third of the canvas.
         Pure decoration — never hit-testable, never focusable, and it carries
         no information, so nothing is lost if a display crops it.
         It sits FIRST so it paints under everything, which is also why the
         shell's pages no longer paint their own opaque background (they set
         Background="Transparent" and this page's parchment shows through).
         The negative margin cancels the TV-safe padding: the motif is
         background, and backgrounds paint the full canvas (2026-07-18). -->
    <Grid
        x:Name="BrandWatermark"
        Margin="-32,-20,-460,-20"
        IsHitTestVisible="False"
        HorizontalAlignment="Right"
        VerticalAlignment="Center">
        <Ellipse Width="1100" Height="1100" Stroke="{ThemeResource RetroWatermarkBrush}" StrokeThickness="3" />
        <Ellipse Width="940" Height="940" Stroke="{ThemeResource RetroWatermarkBrush}" StrokeThickness="2" />
        <Ellipse Width="790" Height="790" Stroke="{ThemeResource RetroWatermarkBrush}" StrokeThickness="3" />
        <Ellipse Width="650" Height="650" Stroke="{ThemeResource RetroWatermarkBrush}" StrokeThickness="2" />
        <Ellipse Width="520" Height="520" Stroke="{ThemeResource RetroWatermarkBrush}" StrokeThickness="3" />
        <Ellipse Width="400" Height="400" Stroke="{ThemeResource RetroWatermarkBrush}" StrokeThickness="2" />
        <!-- The record's label — the one filled shape, so the rings read as a
             disc rather than as abstract circles. Held at under half the
             rings' weight: a solid area at the strokes' own alpha stopped
             reading as a label and started reading as a smudge. -->
        <Ellipse Width="230" Height="230" Opacity="0.45" Fill="{ThemeResource RetroWatermarkBrush}" />
    </Grid>

    <!-- Rounded pane backdrop (checkpoint #8 request, 2026-07-19): the OS
         NavigationView paints its pane background as a hard-edged rectangle,
         so its pane brushes are overridden to Transparent (App.xaml theme
         dictionaries) and this Border supplies the visual instead — radius
         12, matching the now-playing bar's floating look. Width follows the
         pane state (280 open / 48 compact) from PaneOpening/PaneClosing. -->
    <!-- Retro surface (2026-07-19 UI round): the pane backdrop is the logo's
         petrol sleeve teal (RetroSurfaceBrush, theme-aware) instead of the
         neutral acrylic — same radius/geometry as before. -->
    <!-- Bottom alignment (2026-07-22): the now-playing bar floats with a
         16-epx bottom margin, but the pane backdrop used to stretch to the
         full content-area bottom, so the two floating cards ended 16 epx
         apart (read as unbalanced). Matching the bar's bottom inset lines
         them up; the footer hint's bottom margin was raised to clear the
         shortened backdrop's rounded corner. -->
    <!-- Parchment frame (2026-07-27): on light the pane and the play bar are
         cards on a paper ground, so both get the same hairline the browse
         cards carry. Transparent on dark, where the surface separates from
         black unaided. -->
    <Border
        x:Name="PaneBackdrop"
        HorizontalAlignment="Left"
        Width="280"
        Margin="0,0,0,16"
        CornerRadius="12"
        BorderBrush="{ThemeResource RetroPaneBorderBrush}"
        BorderThickness="1"
        Background="{ThemeResource RetroSurfaceBrush}" />

    <!-- Collapsed-rail centering (2026-07-19 — the REAL cause, found by
         reading the 26100 SDK's NavigationViewItemPresenter template over
         SSH): its icon column is HARDCODED to 48 epx regardless of pane
         state, but NavigationView's own default CompactPaneLength is 40 —
         an unrelated resource, never kept in sync with the template's own
         column width. That 8-epx mismatch put every icon's true center
         4 epx off the rail's actual center, on every row uniformly (read
         as "unbalanced" rather than per-icon wobble). Setting the rail to
         48 (below) makes it match the column exactly, so the icon's own
         centering (EnlargeNavIcons) lands on the rail's true center. -->
    <NavigationView
        x:Name="NavView"
        KeyDown="NavView_KeyDown"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="280"
        CompactPaneLength="48"
        SelectionChanged="NavView_SelectionChanged"
        ItemInvoked="NavView_ItemInvoked"
        PaneOpening="NavView_PaneOpening"
        PaneClosing="NavView_PaneClosing">

        <!-- App identity (2026-07-27 branding round): the logo sits at the top
             of the nav pane — the one place a 10-foot app should carry its
             mark, since it is chrome the user already ignores rather than
             content space, and it is present on every screen without being
             repeated on any of them. Deliberately NOT added to page headers,
             the play bar, or as a content watermark: at couch distance a
             repeated logo is noise, and the user knows what they launched.
             PaneHeader is safe here for the same reason PaneFooter's hint is
             (2026-07-17): the 2026-07-14 focus dead-zone lesson concerned
             FOCUSABLE items, and this is inert decoration.
             The mark keeps the whole logo, only scaled (the 2026-07-19 asset
             decision), inside the app's parchment frame; the wordmark beside
             it is real text so it is legible at 10 ft, matching SetupPage's
             logo + title pairing. Both the wordmark and the header's padding
             follow the pane state (PaneOpening/PaneClosing) — 4+40+4 is
             exactly the 48-epx compact rail, so the mark stays centred on it
             when the pane collapses. -->
        <NavigationView.PaneHeader>
            <StackPanel
                x:Name="BrandHeader"
                Orientation="Horizontal"
                Margin="12,10,12,16"
                Spacing="12">
                <Border
                    Width="40"
                    Height="40"
                    BorderBrush="{ThemeResource RetroCardBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/BrandLogo.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel x:Name="BrandWordmark" VerticalAlignment="Center">
                    <TextBlock Text="SubMusic Box" FontSize="19" FontWeight="SemiBold" />
                    <controls:RetroStripes Width="88" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <!-- Footer hint (slimmed 2026-07-22): the pane used to stack two badge
             rows (LB/RB region cycle + Y queue), which read as cramped in the
             280-epx pane. Now that the play bar has its own dedicated View
             jump-key + on-bar badge, only one shortcut needs advertising here:
             LB jumps straight to this menu (direct region jump, 2026-07-22 —
             see ShellRoot_KeyDown). Non-focusable decoration; hidden while the
             pane is collapsed, and its bottom margin clears the pane
             backdrop's shortened rounded corner. -->
        <NavigationView.PaneFooter>
            <StackPanel
                x:Name="NavHintPanel"
                Orientation="Horizontal"
                Margin="16,0,8,28"
                Spacing="8"
                Opacity="0.7">
                <controls:ControllerGlyph Label="LB" />
                <TextBlock
                    Text="Menu"
                    FontSize="15"
                    VerticalAlignment="Center" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <NavigationView.MenuItems>
            <!-- Pane toggle as an ordinary first menu item (checkpoint #8
                 request, 2026-07-19): replaces the built-in Segoe MDL2
                 hamburger (hidden above — it was also a §13.3 icon-set
                 violation). A menu item — not a floated button and not
                 PaneHeader — because ordinary items are the pattern the
                 gamepad focus engine is proven to handle (the 2026-07-14
                 PaneFooter lesson); SelectsOnInvoked=False keeps it out of
                 the selection model, and ItemInvoked toggles the pane.
                 Left-nav refinement (2026-07-23): the glyph is now the same
                 chevron family as the queue/lyrics collapse affordance
                 (chevron_left F2AB when open → collapse, chevron_right F2B1
                 when compact → expand; both cmap-verified), enlarged past
                 the section icons (EnlargeNavIcons special-cases it) and
                 painted in the accent so it reads as a distinct control
                 rather than a nav destination — a directional action glyph,
                 not a noun. The separator that used to sit between it and
                 Search is gone (it read as clunky); a small bottom margin
                 gives it breathing room without a hard rule. -->
            <NavigationViewItem
                x:Name="PaneToggleItem"
                SelectsOnInvoked="False"
                Margin="0,0,0,6"
                AutomationProperties.Name="Expand or collapse the menu">
                <NavigationViewItem.Icon>
                    <FontIcon x:Name="PaneToggleIcon" FontFamily="{StaticResource FluentIconFont}" FontSize="28" Width="28" Height="28" Glyph="&#xF2AB;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Search" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xF690;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xF481;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ArtistsNavItem" Content="Artists" Tag="artists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xF5A9;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AlbumsNavItem" Content="Albums" Tag="albums">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xE010;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Songs" Tag="songs">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xE855;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="PlaylistsNavItem" Content="Playlists" Tag="playlists">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xF4EE;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <!-- Favorites (2026-07-26): last of the library sections, after
                 the browse destinations it draws from. The heart is the same
                 Fluent Regular codepoint the favorite toggles use (F47A), so
                 the nav entry and the action that fills it read as one thing.
                 Hideable from Settings since 2026-07-27 (§12), like the other
                 library sections. -->
            <NavigationViewItem x:Name="FavoritesNavItem" Content="Favorites" Tag="favorites">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xF47A;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- §5: Settings, then Account, as the bottom of the nav order.
                 These lived in PaneFooter until 2026-07-14, but the OS
                 NavigationView's footer is a separate XY focus region the
                 gamepad could not reach (three interception approaches
                 failed on console). As ordinary menu items after a
                 separator, focus, selection, and invoke all work natively.
                 The trade-off — bottom of the list instead of pinned to the
                 pane's bottom edge — is a recorded §16 decision. -->
            <NavigationViewItemSeparator />
            <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xF6AA;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AccountNavItem" Content="Account" Tag="account">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" FontSize="24" Width="24" Height="24" Glyph="&#xE929;" Foreground="{ThemeResource RetroAccentBrush}" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!-- Slice 10 (§10): the now-playing bar owns its own Auto row below
             the content frame — visually floating, but never overlapping
             page content (list bottoms stay reachable). It collapses to
             zero height until the first Play action. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Frame x:Name="ContentFrame" />
            <!-- KeyDown: Up from a bar control must land in the page content
                 above, not in the nav pane (console checkpoint #4 finding —
                 the XY engine preferred the pane's bottom items). -->
            <controls:NowPlayingBar
                x:Name="NowPlaying"
                Grid.Row="1"
                KeyDown="NowPlaying_KeyDown" />
        </Grid>
    </NavigationView>

    <controls:ExpandedQueueView x:Name="QueueOverlay" />

    <!-- Transient feedback surface (Slice 14): last child = topmost, so
         toasts stay visible over the expanded-queue overlay too. The control
         is hit-test-invisible and never focusable, so it cannot disturb the
         overlay's focus trap. -->
    <controls:ToastHost x:Name="Toasts" />

    </Grid>
</Page>
