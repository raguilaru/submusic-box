<Page
    x:Class="BoxSubMusic.App.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Songs browse (Slice 08, requirements §7.3): list-only — no view
         toggle by design — with title, artist, album, length, format and
         bitrate columns. Songs come from search3 with an empty query
         (OpenSubsonic full-library listing, decision 2026-07-13) in
         incrementally loaded pages; non-OpenSubsonic servers get an explicit
         unsupported state instead of a wrong empty list (§3). A/Enter on a
         row starts immediate playback (decision 2026-07-13, live since Slice
         10): the queue becomes all rows loaded so far, positioned at the
         chosen song. The Menu button opens the secondary context menu. -->
    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
            <TextBlock
                Text="Songs"
                FontSize="48"
                FontWeight="SemiBold" />
            <controls:RetroStripes Width="150" HorizontalAlignment="Left" Margin="0,8,0,0" />

            <!-- Sort + whole-library playback. All three act on the ENTIRE
                 library, so they stay disabled until the background load has
                 pulled every page in (see SongsPage.LoadAsync) — "Title" must
                 not mean "the first few hundred rows". Glyphs are Fluent
                 Regular, cmap-verified against the shipped TTF (§13.3):
                 arrow_sort F18B, chevron_down F2A4, play F606, shuffle EF37. -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
                <Button
                    x:Name="SortButton"
                    Style="{StaticResource RetroTonalButtonStyle}"
                    Padding="20,12"
                    IsEnabled="False"
                    AutomationProperties.Name="Sort songs">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF18B;" FontSize="20" />
                        <TextBlock x:Name="SortLabel" Text="Default Order" FontSize="20" VerticalAlignment="Center" />
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF2A4;" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <!-- ToggleMenuFlyoutItem, not RadioMenuFlyoutItem: the
                             check mark reads as the current sort and the type
                             is available on the app's UWP baseline. Mutual
                             exclusion is applied in ApplySort. -->
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem x:Name="SortDefaultItem" Text="Default Order" IsChecked="True" Click="SortItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="SortTitleItem" Text="Title" Click="SortItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="SortArtistItem" Text="Artist" Click="SortItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="SortAlbumItem" Text="Album" Click="SortItem_Click" />
                            <ToggleMenuFlyoutItem x:Name="SortDateAddedItem" Text="Date Added" Click="SortItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="PlayAllButton"
                    Style="{StaticResource RetroPrimaryButtonStyle}"
                    Padding="28,12"
                    IsEnabled="False"
                    Click="PlayAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="20" />
                        <TextBlock Text="Play All" FontSize="20" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ShuffleAllButton"
                    Style="{StaticResource RetroTonalButtonStyle}"
                    Padding="28,12"
                    IsEnabled="False"
                    Click="ShuffleAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="20" />
                        <TextBlock Text="Shuffle All" FontSize="20" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Why the three controls above are still disabled. Rows are
                     already visible and playable while this shows (§15: the
                     wait is stated, never silent). -->
                <TextBlock
                    x:Name="LoadingAllText"
                    Visibility="Collapsed"
                    Text="Loading all songs…"
                    FontSize="16"
                    Opacity="0.7"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Controller hints as monochrome button badges (checkpoint #7
                 request, 2026-07-18 — replaces the static sentence). -->
            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7" Margin="0,12,0,0">
                <controls:ControllerGlyph Label="A" />
                <TextBlock Text="Play" FontSize="15" VerticalAlignment="Center" />
                <controls:ControllerGlyph Label="Menu" Margin="16,0,0,0" />
                <TextBlock Text="More options" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- Content states share row 1; only one is visible at a time. -->
        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                Text="This server has no songs."
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <Grid x:Name="SongsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers, mirroring the row template's grid. The
                     28-epx column after Title is the starred-heart marker
                     (checkpoint #4 feedback) — no header text. -->
                <Grid Grid.Row="0" ColumnSpacing="16" Padding="12,0,12,10" Opacity="0.6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Artist" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Album" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Length" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Format" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Bitrate" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                </Grid>

                <ListView
                    x:Name="SongsList"
                    Grid.Row="1"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="SongsList_ItemClick"
                    ContextRequested="SongsList_ContextRequested"
                    XYFocusUp="{x:Bind SortButton}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SongRow">
                            <Grid ColumnSpacing="16" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <!-- Secondary actions (decision 2026-07-13).
                                         Pointer right-click opens this directly;
                                         the gamepad Menu button raises
                                         ContextRequested on the focused
                                         ListViewItem instead, which the
                                         ListView-level handler redirects here
                                         (console finding 2026-07-14). -->
                                    <!-- Icons: Fluent Regular glyphs, all
                                         cmap-verified (§13.3) — play F606,
                                         play-next E861 (navigation_play: queue
                                         lines + a play triangle, so it doesn't
                                         read as skip like the bar's next F56A),
                                         list-add F7A8, heart F47A, album E010. -->
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="Play"
                                            Tag="{x:Bind}"
                                            Click="PlaySong_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Text="Play next"
                                            Tag="{x:Bind}"
                                            Click="PlayNext_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Text="Add to queue"
                                            Tag="{x:Bind}"
                                            Click="AddToQueue_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Text="{x:Bind FavoriteLabel, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="ToggleFavorite_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF47A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Text="Go to album"
                                            Tag="{x:Bind}"
                                            Click="GoToAlbum_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE010;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="18" TextTrimming="CharacterEllipsis" />
                                <!-- Starred marker (checkpoint #4): filled
                                     heart, accent, shown only on favorites. -->
                                <FontIcon
                                    Grid.Column="1"
                                    FontFamily="{StaticResource FluentIconFilledFont}"
                                    Glyph="&#xF47E;"
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                    Visibility="{x:Bind StarredVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Artist}" FontSize="18" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Album}" FontSize="18" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DurationLabel}" FontSize="18" Opacity="0.7" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Format}" FontSize="18" Opacity="0.7" />
                                <TextBlock Grid.Column="6" Text="{x:Bind BitRateLabel}" FontSize="18" Opacity="0.7" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
