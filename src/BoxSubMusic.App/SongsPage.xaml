<Page
    x:Class="BoxSubMusic.App.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Songs browse (Slice 08, requirements §7.3): list-only — no view
         toggle by design — with title, artist, album, length, format and
         bitrate columns. Songs come from search3 with an empty query
         (OpenSubsonic full-library listing, decision 2026-07-13) in
         incrementally loaded pages; non-OpenSubsonic servers get an explicit
         unsupported state instead of a wrong empty list (§3). The row primary
         action (A/Enter = immediate playback, decision 2026-07-13) arrives
         with Slice 10; rows are inert with a visible note (§15). The Menu
         button opens the secondary context menu; "Go to album" is live. -->
    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
            <TextBlock
                Text="Songs"
                FontSize="48"
                FontWeight="SemiBold" />
            <TextBlock
                Text="Playback arrives in a later update. Press Menu on a song for options."
                FontSize="15"
                Opacity="0.6"
                FontStyle="Italic" />
        </StackPanel>

        <!-- Content states share row 1; only one is visible at a time. -->
        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                Text="This server has no songs."
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <Grid x:Name="SongsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers, mirroring the row template's grid. -->
                <Grid Grid.Row="0" ColumnSpacing="16" Padding="12,0,12,10" Opacity="0.6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Artist" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Album" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Length" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Format" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Bitrate" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                </Grid>

                <ListView
                    x:Name="SongsList"
                    Grid.Row="1"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ContextRequested="SongsList_ContextRequested">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SongRow">
                            <Grid ColumnSpacing="16" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <!-- Secondary actions (decision 2026-07-13).
                                         Pointer right-click opens this directly;
                                         the gamepad Menu button raises
                                         ContextRequested on the focused
                                         ListViewItem instead, which the
                                         ListView-level handler redirects here
                                         (console finding 2026-07-14). -->
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="Play (arrives in a later update)"
                                            IsEnabled="False" />
                                        <MenuFlyoutItem
                                            Text="Go to album"
                                            Tag="{x:Bind}"
                                            Click="GoToAlbum_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="18" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Artist}" FontSize="18" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="18" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind DurationLabel}" FontSize="18" Opacity="0.7" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Format}" FontSize="18" Opacity="0.7" />
                                <TextBlock Grid.Column="5" Text="{x:Bind BitRateLabel}" FontSize="18" Opacity="0.7" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
