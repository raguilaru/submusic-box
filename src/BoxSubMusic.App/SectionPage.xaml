<Page
    x:Class="BoxSubMusic.App.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Slice 04 placeholder host for sections whose real content arrives in
         later slices (Home is Slice 05, browse views are Slices 06-09). -->
    <StackPanel Padding="48" Spacing="16">
        <TextBlock
            x:Name="SectionTitle"
            FontSize="48"
            FontWeight="SemiBold" />
        <TextBlock
            x:Name="SectionNote"
            FontSize="24"
            Opacity="0.7"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
