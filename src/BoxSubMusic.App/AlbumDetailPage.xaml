<Page
    x:Class="BoxSubMusic.App.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Album detail (Slices 07a + 07b, requirements §9): mirrors the artist
         detail layout — large artwork, title, artist, year, favorite heart
         (persisted via star/unstar), song count + total duration, and the
         track list in disc/track order. Since Slice 10 the deferred 07b
         behavior is live: Play/Shuffle replace the queue with this album's
         tracks, selecting a row jumps playback to that track, and the
         current track is highlighted. -->
    <Grid>
        <ScrollViewer x:Name="ContentScroller" Visibility="Collapsed" Padding="48,36,48,36">
            <StackPanel Spacing="36">
                <!-- Header: artwork + metadata, same shape as artist detail. -->
                <Grid ColumnSpacing="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="320" Height="320" CornerRadius="12">
                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <FontIcon
                                FontFamily="{StaticResource FluentIconFont}"
                                Glyph="&#xE855;"
                                FontSize="96"
                                Opacity="0.4" />
                        </Border>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                        <TextBlock
                            x:Name="AlbumNameText"
                            FontSize="48"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="AlbumArtistText"
                            FontSize="26"
                            Opacity="0.8" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <!-- Starred = accent-filled heart with a black
                                 rim (shared FavoriteHeart; checkpoint #4
                                 redesign) — the state lives in the glyph,
                                 not the button chrome. -->
                            <controls:FavoriteHeart
                                x:Name="FavoriteToggle"
                                Padding="12"
                                GlyphSize="28"
                                Checked="FavoriteToggle_Changed"
                                Unchecked="FavoriteToggle_Changed"
                                ToolTipService.ToolTip="Favorite" />
                            <TextBlock
                                x:Name="FavoriteStatusText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Opacity="0.8"
                                Visibility="Collapsed"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Year · song count · total duration (§9). -->
                        <TextBlock
                            x:Name="MetaText"
                            FontSize="22"
                            Opacity="0.8" />

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <!-- §9: Play/Shuffle replace the queue with this
                                 album's tracks only (live since Slice 10). -->
                            <Button x:Name="PlayButton" Padding="28,12" Click="PlayButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="20" />
                                    <TextBlock Text="Play" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShuffleButton" Padding="28,12" Click="ShuffleButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="20" />
                                    <TextBlock Text="Shuffle" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Queue edits (2026-07-18): the container forms
                                 of "Play next"/"Add to queue" — this album's
                                 tracks, without replacing the queue. Icon-only
                                 to keep the row from crowding; same
                                 cmap-verified glyphs as the song menus. -->
                            <Button
                                x:Name="PlayNextButton"
                                Padding="16,12"
                                Click="PlayNextButton_Click"
                                ToolTipService.ToolTip="Play next"
                                AutomationProperties.Name="Play next">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" FontSize="20" />
                            </Button>
                            <Button
                                x:Name="AddToQueueButton"
                                Padding="16,12"
                                Click="AddToQueueButton_Click"
                                ToolTipService.ToolTip="Add to queue"
                                AutomationProperties.Name="Add to queue">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" FontSize="20" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Track list in original disc/track order (§9). A/Enter on a
                     row jumps playback directly to that track (Slice 10). -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Tracks" FontSize="32" FontWeight="SemiBold" />
                    <!-- Controller hints as monochrome button badges
                         (checkpoint #7 request, 2026-07-18). -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                        <controls:ControllerGlyph Label="A" />
                        <TextBlock Text="Play from track" FontSize="15" VerticalAlignment="Center" />
                        <controls:ControllerGlyph Label="Menu" Margin="16,0,0,0" />
                        <TextBlock Text="More options" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="NoTracksText"
                        Text="No tracks for this album."
                        FontSize="20"
                        Opacity="0.7"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="TracksList"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="TracksList_ItemClick"
                        ContextRequested="TracksList_ContextRequested">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackRow">
                                <Grid ColumnSpacing="16" Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <!-- Same pattern as the Songs page
                                             (console feedback 2026-07-14):
                                             pointer right-click opens this
                                             directly; the gamepad Menu button
                                             raises ContextRequested on the
                                             focused ListViewItem, redirected
                                             here by the ListView handler.
                                             "Go to album" would be circular on
                                             this page, so the live action is
                                             "Go to artist". -->
                                        <!-- Icons: Fluent Regular glyphs, all
                                             cmap-verified (§13.3) — play F606,
                                             next F56A, list-add F7A8, heart
                                             F47A, person F5BE. -->
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Play"
                                                Tag="{x:Bind}"
                                                Click="PlayTrack_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Text="Play next"
                                                Tag="{x:Bind}"
                                                Click="PlayNext_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Text="Add to queue"
                                                Tag="{x:Bind}"
                                                Click="AddToQueue_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="{x:Bind FavoriteLabel, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Click="ToggleFavorite_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF47A;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="Go to artist"
                                                Tag="{x:Bind}"
                                                IsEnabled="{x:Bind HasArtistId}"
                                                Click="GoToArtist_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF5BE;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <!-- Starred-heart marker column
                                             (checkpoint #4 feedback). -->
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <!-- §9 current-track highlight: the number
                                         column swaps to an accent now-playing
                                         marker (accent glyph on the normal row
                                         background — NOT the accent-on-accent
                                         trap from the favorite heart). -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Number}"
                                        Visibility="{x:Bind NumberVisibility, Mode=OneWay}"
                                        FontSize="20"
                                        Opacity="0.6"
                                        TextAlignment="Right" />
                                    <FontIcon
                                        Grid.Column="0"
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xE855;"
                                        FontSize="20"
                                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                        Visibility="{x:Bind NowPlayingVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Right" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Title}"
                                        FontSize="20"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontFamily="{StaticResource FluentIconFilledFont}"
                                        Glyph="&#xF47E;"
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                        Visibility="{x:Bind StarredVisibility, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind Artist}"
                                        FontSize="18"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis"
                                        MaxWidth="420" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind DurationLabel}"
                                        FontSize="20"
                                        Opacity="0.6"
                                        TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <StackPanel
            x:Name="ErrorPanel"
            Visibility="Collapsed"
            Spacing="16"
            MaxWidth="820"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="ErrorText"
                FontSize="22"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <Button
                x:Name="RetryButton"
                Content="Retry"
                FontSize="20"
                Padding="40,10"
                HorizontalAlignment="Center"
                Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Page>
