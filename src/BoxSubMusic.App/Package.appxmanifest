<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap uap3 mp">

  <Identity
    Name="ConsoleApps.SubMusicBox"
    Publisher="CN=AAEFF031-B87C-4F14-849C-C775D7E4D2DB"
    Version="1.0.1.0" />

  <mp:PhoneIdentity PhoneProductId="75aa6876-ea64-4d0e-9df6-06a02419ac51" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>SubMusic Box</DisplayName>
    <PublisherDisplayName>PolyApps</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="BoxSubMusic.App.App">
      <uap:VisualElements
        DisplayName="SubMusic Box"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="SubMusic Box — music streaming for Subsonic and OpenSubsonic servers"
        BackgroundColor="#1E1E1C">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1E1E1C" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Requirement §2: LAN servers (e.g. Navidrome on a Pi) are unreachable
         with internetClient alone. -->
    <Capability Name="privateNetworkClientServer" />
    <!-- Requirement §11: playback must continue when the app is backgrounded.
         Also subjects the app to background memory limits on Xbox. -->
    <uap3:Capability Name="backgroundMediaPlayback" />
  </Capabilities>
</Package>
