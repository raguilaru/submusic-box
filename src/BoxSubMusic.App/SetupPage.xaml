<Page
    x:Class="BoxSubMusic.App.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:setup="using:BoxSubMusic.Core.Setup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
    Slice 03 (requirements §4): first-launch server connection.
    Deliberately NO XYFocusKeyboardNavigation on this page: arrow keys must
    stay inside the text boxes for caret movement (see the Slice 01 note in
    MainPage.xaml). Gamepad XY focus works page-wide regardless.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="720"
            Margin="48,64"
            HorizontalAlignment="Center"
            Spacing="20">

            <StackPanel Orientation="Horizontal" Spacing="20">
                <Image
                    Source="ms-appx:///Assets/BrandLogo.png"
                    Width="88"
                    Height="88"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="SubMusic Box"
                    FontSize="48"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                Text="Connect to your Subsonic or OpenSubsonic server."
                FontSize="22"
                Opacity="0.7"
                TextWrapping="Wrap"
                Margin="0,0,0,12" />

            <!--
            Enter advances to the next field (Connect from the last one), so
            the console OSK's accept — the Menu-button accelerator — walks
            the whole form without B or D-pad. Explicit TabIndex keeps
            hardware-keyboard Tab on the same path (§13.1).
            -->
            <TextBox
                x:Name="ServerUrlBox"
                Header="Server address"
                PlaceholderText="https://music.example.com"
                FontSize="22"
                InputScope="Url"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                TabIndex="0"
                KeyDown="ServerUrlBox_KeyDown" />

            <TextBox
                x:Name="UsernameBox"
                Header="Username"
                FontSize="22"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                TabIndex="1"
                KeyDown="UsernameBox_KeyDown" />

            <!-- Masked entry is the PasswordBox default (§4). -->
            <PasswordBox
                x:Name="PasswordInput"
                Header="Password"
                FontSize="22"
                TabIndex="2"
                KeyDown="PasswordInput_KeyDown" />

            <!-- Inline gamepad editing hint (console finding 2026-07-14).
                 Static for now; dynamic input-glyph swapping is a §13.1
                 SHOULD deferred to a later slice. -->
            <TextBlock
                Text="Controller: X deletes · LB / RB move the cursor · X on the password clears it"
                FontSize="16"
                Opacity="0.55"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="ErrorText"
                Visibility="Collapsed"
                Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                FontSize="20"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                <Button
                    x:Name="ConnectButton"
                    Content="Connect"
                    FontSize="24"
                    Padding="48,12"
                    TabIndex="3"
                    Click="ConnectButton_Click" />
                <ProgressRing
                    x:Name="ConnectProgress"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel
                x:Name="RecentPanel"
                Visibility="Collapsed"
                Spacing="8"
                Margin="0,24,0,0">
                <TextBlock
                    Text="Recent servers"
                    FontSize="24"
                    FontWeight="SemiBold" />
                <ListView
                    x:Name="RecentList"
                    IsItemClickEnabled="True"
                    SelectionMode="None"
                    ItemClick="RecentList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="setup:RecentServer">
                            <StackPanel Padding="4,10">
                                <TextBlock Text="{x:Bind Url}" FontSize="22" />
                                <TextBlock Text="{x:Bind Username}" FontSize="18" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
