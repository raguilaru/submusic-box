<Page
    x:Class="BoxSubMusic.App.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Slice 05a (requirements §6): Home. Three album carousels; §6.1's
         resume card renders only when persisted playback context exists.
         No queue persistence exists until the playback slices, so the card
         is intentionally absent — Slice 05b adds it (decision 2026-07-10). -->
    <Grid>
        <!-- Page-level connection failure (restored client could not reach
             or authenticate with the server). Explicit, with retry (§3). -->
        <StackPanel
            x:Name="ConnectErrorPanel"
            Visibility="Collapsed"
            Padding="48"
            Spacing="16"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            MaxWidth="900">
            <TextBlock
                Text="Can't reach your server"
                FontSize="36"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="ConnectErrorText"
                FontSize="22"
                Opacity="0.85"
                TextWrapping="Wrap" />
            <Button
                x:Name="ConnectRetryButton"
                Content="Retry"
                FontSize="24"
                Padding="48,12"
                Margin="0,16,0,0"
                Click="ConnectRetryButton_Click" />
        </StackPanel>

        <ScrollViewer
            x:Name="CarouselsScroller"
            VerticalScrollMode="Enabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,48,48,64" Spacing="40">
                <TextBlock
                    Text="Home"
                    FontSize="48"
                    FontWeight="SemiBold" />
                <controls:RetroStripes Width="150" HorizontalAlignment="Left" Margin="0,-28,0,0" />

                <!-- Slice 05b (§6.1): resume card. Shown only when a valid
                     persisted queue exists for this server AND nothing is
                     playing this session (an active queue means the bar
                     already shows the same truth). The whole card is the
                     Play action: pressing it restores the queue at the saved
                     track + position and starts playing (decision
                     2026-07-16 — launch itself never restores anything, so
                     §6.1's "no auto-play on launch" holds by construction). -->
                <StackPanel
                    x:Name="ResumeSection"
                    Visibility="Collapsed"
                    Spacing="16">
                    <TextBlock
                        Text="Pick up where you left off"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <controls:RetroStripes Width="110" HorizontalAlignment="Left" Margin="0,-8,0,0" />
                    <Button
                        x:Name="ResumeCard"
                        Padding="0"
                        CornerRadius="8"
                        Click="ResumeCard_Click">
                        <Grid Height="160" MinWidth="560">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="160" Height="160">
                                <!-- Same placeholder treatment as the album
                                     cards: the vinyl disc shows until artwork
                                     loads (or when there is none). -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <controls:VinylDisc Margin="16" />
                                </Border>
                                <Image x:Name="ResumeArtImage" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="24,0"
                                Spacing="6">
                                <TextBlock
                                    x:Name="ResumeName"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ResumeTrack"
                                    FontSize="18"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                FontFamily="{StaticResource FluentIconFont}"
                                Glyph="&#xF606;"
                                FontSize="32"
                                Margin="0,0,32,0"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <controls:AlbumCarousel
                    x:Name="MostPlayedCarousel"
                    Title="Most played"
                    EmptyMessage="Nothing here yet — your most played albums appear as you listen."
                    RetryRequested="MostPlayedCarousel_RetryRequested"
                    AlbumClicked="Carousel_AlbumClicked" />

                <controls:AlbumCarousel
                    x:Name="RecentlyAddedCarousel"
                    Title="Recently added"
                    EmptyMessage="No albums on the server yet."
                    RetryRequested="RecentlyAddedCarousel_RetryRequested"
                    AlbumClicked="Carousel_AlbumClicked" />

                <controls:AlbumCarousel
                    x:Name="RandomPicksCarousel"
                    Title="Random picks"
                    EmptyMessage="No albums on the server yet."
                    RetryRequested="RandomPicksCarousel_RetryRequested"
                    AlbumClicked="Carousel_AlbumClicked" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
