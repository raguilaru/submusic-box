<Page
    x:Class="BoxSubMusic.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Slice 04: nav-visibility plumbing (§5). The full settings experience
         (theme selector etc.) is Slice 12. -->
    <StackPanel Padding="48" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock
            Text="Settings"
            FontSize="48"
            FontWeight="SemiBold" />

        <TextBlock
            Text="Navigation"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,24,0,0" />
        <TextBlock
            Text="Search and Home are always shown."
            FontSize="20"
            Opacity="0.7" />

        <ToggleSwitch
            x:Name="ArtistsToggle"
            Header="Show Artists"
            FontSize="20"
            Toggled="Toggle_Toggled" />
        <ToggleSwitch
            x:Name="AlbumsToggle"
            Header="Show Albums"
            FontSize="20"
            Toggled="Toggle_Toggled" />
        <ToggleSwitch
            x:Name="PlaylistsToggle"
            Header="Show Playlists"
            FontSize="20"
            Toggled="Toggle_Toggled" />

        <TextBlock
            Text="Theme options (Automatic, Dark, Light) arrive in a later slice."
            FontSize="20"
            Opacity="0.7"
            Margin="0,24,0,0" />
    </StackPanel>
</Page>
