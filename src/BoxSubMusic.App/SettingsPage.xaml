<Page
    x:Class="BoxSubMusic.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Slice 04: nav-visibility plumbing (§5). Slice 12: theme selector (§12). -->
    <StackPanel Padding="48" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <!-- Page-title stripe motif (2026-07-27) — see the AccountPage note. -->
        <TextBlock
            Text="Settings"
            FontSize="48"
            FontWeight="SemiBold" />
        <controls:RetroStripes Width="150" HorizontalAlignment="Left" Margin="0,-8,0,0" />

        <TextBlock
            Text="Navigation"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,24,0,0" />
        <TextBlock
            Text="Search and Home are always shown."
            FontSize="20"
            Opacity="0.7" />

        <!-- Explicit XYFocus chain (console finding 2026-07-15): gamepad
             up/down between the switches strayed into the nav pane instead
             of walking the column. The edges pin to themselves so up/down
             never leaves the page — the nav is reached with Left, per the
             focus convention. -->
        <ToggleSwitch
            x:Name="ArtistsToggle"
            Header="Show Artists"
            FontSize="20"
            XYFocusUp="{x:Bind ArtistsToggle}"
            XYFocusDown="{x:Bind AlbumsToggle}"
            Toggled="Toggle_Toggled" />
        <ToggleSwitch
            x:Name="AlbumsToggle"
            Header="Show Albums"
            FontSize="20"
            XYFocusUp="{x:Bind ArtistsToggle}"
            XYFocusDown="{x:Bind PlaylistsToggle}"
            Toggled="Toggle_Toggled" />
        <ToggleSwitch
            x:Name="PlaylistsToggle"
            Header="Show Playlists"
            FontSize="20"
            XYFocusUp="{x:Bind AlbumsToggle}"
            XYFocusDown="{x:Bind FavoritesToggle}"
            Toggled="Toggle_Toggled" />
        <!-- Favorites (added 2026-07-27, §16): originally spec'd as
             non-hideable, now toggleable like the other library sections at
             Rafael's request. Search and Home remain fixed by construction —
             they have no setting at all. -->
        <ToggleSwitch
            x:Name="FavoritesToggle"
            Header="Show Favorites"
            FontSize="20"
            XYFocusUp="{x:Bind PlaylistsToggle}"
            XYFocusDown="{x:Bind ThemeAutomatic}"
            Toggled="Toggle_Toggled" />

        <!-- Slice 12 (§12): theme selector. Radio buttons over a ComboBox by
             design — a ComboBox popup is an extra focus scope and A-press on
             the controller; radios keep every option visible and one press
             away, and the selection is glanceable from the couch. Selecting
             applies instantly (the console convention — the Xbox's own theme
             setting behaves the same). The XYFocus chain continues from the
             nav toggles; the bottom edge pins to itself. -->
        <TextBlock
            Text="Theme"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,24,0,0" />
        <TextBlock
            Text="Automatic follows the Xbox system theme."
            FontSize="20"
            Opacity="0.7" />

        <!-- Bullet/label alignment (console checkpoint #6 note): the OS
             RadioButton template top-anchors the bullet in a fixed 32-epx
             band (center y=16) and gives the content Padding="8,6,0,0" with
             Top alignment — tuned for the default 14-epx font, so our 20-epx
             labels sat ~4 epx low. Zeroing the top padding and centering the
             content puts both centers at 16 (verified against the 26100 SDK
             generic.xaml template). -->
        <RadioButton
            x:Name="ThemeAutomatic"
            Content="Automatic"
            GroupName="Theme"
            FontSize="20"
            Padding="8,0,0,0"
            VerticalContentAlignment="Center"
            XYFocusUp="{x:Bind FavoritesToggle}"
            XYFocusDown="{x:Bind ThemeDark}"
            Checked="Theme_Checked" />
        <RadioButton
            x:Name="ThemeDark"
            Content="Dark"
            GroupName="Theme"
            FontSize="20"
            Padding="8,0,0,0"
            VerticalContentAlignment="Center"
            XYFocusUp="{x:Bind ThemeAutomatic}"
            XYFocusDown="{x:Bind ThemeLight}"
            Checked="Theme_Checked" />
        <RadioButton
            x:Name="ThemeLight"
            Content="Light"
            GroupName="Theme"
            FontSize="20"
            Padding="8,0,0,0"
            VerticalContentAlignment="Center"
            XYFocusUp="{x:Bind ThemeDark}"
            XYFocusDown="{x:Bind ThemeLight}"
            Checked="Theme_Checked" />
    </StackPanel>
</Page>
