<Page
    x:Class="BoxSubMusic.App.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- §5: account / server info. Passwords are never displayed. -->
    <StackPanel Padding="48" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock
            Text="Account"
            FontSize="48"
            FontWeight="SemiBold" />

        <TextBlock
            x:Name="ServerText"
            FontSize="24"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="UsernameText"
            FontSize="24" />
        <TextBlock
            x:Name="ServerInfoText"
            FontSize="20"
            Opacity="0.7"
            TextWrapping="Wrap" />

        <Button
            x:Name="SignOutButton"
            Content="Sign out"
            FontSize="24"
            Padding="48,12"
            Margin="0,24,0,0"
            Click="SignOutButton_Click" />
    </StackPanel>
</Page>
