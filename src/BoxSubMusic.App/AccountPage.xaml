<Page
    x:Class="BoxSubMusic.App.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- §5: account / server info. Passwords are never displayed. -->
    <StackPanel Padding="48" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <!-- Page-title stripe motif (2026-07-27): every browse page carries
             it; Settings and Account were the two that did not, which is part
             of why they read as the emptiest screens in the app. -->
        <TextBlock
            Text="Account"
            FontSize="48"
            FontWeight="SemiBold" />
        <controls:RetroStripes Width="150" HorizontalAlignment="Left" Margin="0,-8,0,0" />

        <TextBlock
            x:Name="ServerText"
            FontSize="24"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="UsernameText"
            FontSize="24" />
        <TextBlock
            x:Name="ServerInfoText"
            FontSize="20"
            Opacity="0.7"
            TextWrapping="Wrap" />

        <Button
            x:Name="SignOutButton"
            Content="Sign out"
            FontSize="24"
            Padding="48,12"
            Margin="0,24,0,0"
            Click="SignOutButton_Click" />

        <!-- Diagnostics (§11 background-memory investigation, 2026-08-13).
             Temporary scaffolding, not product surface: it exists to run the
             one measurement that reading the code cannot settle — how much of
             the app's ~139 MB resting footprint is artwork. Browse the same
             path with it off and then on, and compare the EnteredBackground
             lines in background-diagnostics.log. Remove this block once the
             question is answered. It lives on Account rather than Settings
             because Settings is product surface. -->
        <TextBlock
            Text="Diagnostics"
            FontSize="24"
            FontWeight="SemiBold"
            Margin="0,40,0,0" />
        <ToggleSwitch
            x:Name="SuppressArtworkToggle"
            Header="Run without artwork"
            OnContent="On"
            OffContent="Off"
            Toggled="SuppressArtworkToggle_Toggled" />
        <TextBlock
            Text="Memory measurement only: the app requests no cover art at all. Restart the app after changing this, then browse as usual and read background-diagnostics.log."
            FontSize="18"
            Opacity="0.7"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
