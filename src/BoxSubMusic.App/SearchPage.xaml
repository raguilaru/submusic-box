<Page
    x:Class="BoxSubMusic.App.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Search (Slice 13, requirements §5/§17 resolution 2026-07-19): the
         query runs on submit (Enter / OSK accept — no live-as-you-type churn),
         and the scope filters live in the content area, appearing once a
         search has run (§5). The default "All" view shows the top artists,
         albums and songs from one search3 request; picking a scope filter
         switches to a full incrementally paged list for that scope (the
         browse-view IncrementalSource pattern). Artist/album results open
         their detail pages; A on a song replaces the queue with the loaded
         song results positioned at that song (the Songs-browse semantics).
         Servers older than API 1.8 (which introduced search) get an explicit
         unsupported state (§3). -->

    <Page.Resources>
        <!-- One song-row template for both the All section and the scoped
             Songs list: the Songs-browse columns (§7.3 set) plus the starred
             marker, with the full song context menu — Play, queue edits,
             favorite, and BOTH navigation items (neither is circular here). -->
        <DataTemplate x:Key="SearchSongRowTemplate" x:DataType="models:SongRow">
            <Grid ColumnSpacing="16" Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="Play"
                            Tag="{x:Bind}"
                            Click="PlaySong_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="Play next"
                            Tag="{x:Bind}"
                            Click="PlayNext_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="Add to queue"
                            Tag="{x:Bind}"
                            Click="AddToQueue_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="{x:Bind FavoriteLabel, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Click="ToggleFavorite_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF47A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="Go to album"
                            Tag="{x:Bind}"
                            IsEnabled="{x:Bind HasAlbumId}"
                            Click="GoToAlbum_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE010;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="Go to artist"
                            Tag="{x:Bind}"
                            IsEnabled="{x:Bind HasArtistId}"
                            Click="GoToArtist_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF5BE;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="18" TextTrimming="CharacterEllipsis" />
                <FontIcon
                    Grid.Column="1"
                    FontFamily="{StaticResource FluentIconFilledFont}"
                    Glyph="&#xF47E;"
                    FontSize="16"
                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                    Visibility="{x:Bind StarredVisibility, Mode=OneWay}"
                    VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Artist}" FontSize="18" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind Album}" FontSize="18" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{x:Bind DurationLabel}" FontSize="18" Opacity="0.7" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{x:Bind Format}" FontSize="18" Opacity="0.7" />
                <TextBlock Grid.Column="6" Text="{x:Bind BitRateLabel}" FontSize="18" Opacity="0.7" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- Artist card, the Artists-browse visual language (§7.1). -->
        <DataTemplate x:Key="SearchArtistCardTemplate" x:DataType="models:ArtistCard">
            <StackPanel Width="200" Spacing="8">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="Play next"
                            Tag="{x:Bind}"
                            Click="ArtistPlayNext_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="Add to queue"
                            Tag="{x:Bind}"
                            Click="ArtistAddToQueue_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <Grid Width="200" Height="200" CornerRadius="8">
                    <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <FontIcon
                            FontFamily="{StaticResource FluentIconFont}"
                            Glyph="&#xF5A9;"
                            FontSize="64"
                            Opacity="0.4" />
                    </Border>
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{x:Bind ArtworkUri}" DecodePixelWidth="400" />
                        </Image.Source>
                    </Image>
                </Grid>
                <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind AlbumCountLabel}" FontSize="16" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>

        <!-- Album card, the Albums-browse visual language (§7.2). -->
        <DataTemplate x:Key="SearchAlbumCardTemplate" x:DataType="models:AlbumCard">
            <StackPanel Width="200" Spacing="8">
                <StackPanel.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="Play next"
                            Tag="{x:Bind}"
                            Click="AlbumPlayNext_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="Add to queue"
                            Tag="{x:Bind}"
                            Click="AlbumAddToQueue_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </StackPanel.ContextFlyout>
                <Grid Width="200" Height="200" CornerRadius="8">
                    <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <FontIcon
                            FontFamily="{StaticResource FluentIconFont}"
                            Glyph="&#xE855;"
                            FontSize="64"
                            Opacity="0.4" />
                    </Border>
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{x:Bind ArtworkUri}" DecodePixelWidth="400" />
                        </Image.Source>
                    </Image>
                </Grid>
                <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Search"
            FontSize="48"
            FontWeight="SemiBold"
            Margin="0,0,0,16" />

        <!-- Query row: submit on Enter (the OSK accept); the button covers
             mouse users (§13.1). While the box has focus, X/LB/RB do inline
             gamepad editing (the console-verified SetupPage mapping), which
             deliberately takes precedence over LB/RB region cycling. -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="QueryBox"
                Grid.Column="0"
                MaxWidth="820"
                HorizontalAlignment="Left"
                MinWidth="560"
                FontSize="20"
                PlaceholderText="Search artists, albums, and songs"
                InputScope="Search"
                KeyDown="QueryBox_KeyDown" />
            <Button
                x:Name="SearchButton"
                Grid.Column="1"
                Padding="24,8"
                VerticalAlignment="Stretch"
                Click="SearchButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF690;" FontSize="20" />
                    <TextBlock Text="Search" FontSize="18" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Scope filters (§5: in the content area, visible once search is
             active). Segmented toggles, exclusivity managed in code. -->
        <StackPanel
            x:Name="FilterPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,0,16"
            Visibility="Collapsed">
            <ToggleButton x:Name="FilterAllButton" Content="All" FontSize="18" Padding="24,6" IsChecked="True" Click="Filter_Click" />
            <ToggleButton x:Name="FilterArtistsButton" Content="Artists" FontSize="18" Padding="24,6" Click="Filter_Click" />
            <ToggleButton x:Name="FilterAlbumsButton" Content="Albums" FontSize="18" Padding="24,6" Click="Filter_Click" />
            <ToggleButton x:Name="FilterSongsButton" Content="Songs" FontSize="18" Padding="24,6" Click="Filter_Click" />
        </StackPanel>

        <!-- Content states share row 3; only one is visible at a time. -->
        <Grid Grid.Row="3">
            <!-- Pristine state: no search has run yet. -->
            <StackPanel
                x:Name="IdlePanel"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="820">
                <TextBlock
                    Text="Type what you are looking for, then press Enter."
                    FontSize="24"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7" HorizontalAlignment="Center">
                    <controls:ControllerGlyph Label="A" />
                    <TextBlock Text="Type" FontSize="15" VerticalAlignment="Center" />
                    <controls:ControllerGlyph Label="X" Margin="16,0,0,0" />
                    <TextBlock Text="Delete" FontSize="15" VerticalAlignment="Center" />
                    <controls:ControllerGlyph Label="LB" Margin="16,0,0,0" />
                    <controls:ControllerGlyph Label="RB" />
                    <TextBlock Text="Move cursor" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="820"
                TextAlignment="Center" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <!-- "All" scope: top results per scope in one scrolling column.
                 Sections with no matches collapse. -->
            <ScrollViewer x:Name="AllScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,24">
                    <StackPanel x:Name="AllArtistsSection" Spacing="12">
                        <TextBlock Text="Artists" FontSize="28" FontWeight="SemiBold" />
                        <ListView
                            x:Name="AllArtistsList"
                            XYFocusUp="{x:Bind FilterAllButton}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="Artist_ItemClick"
                            ContextRequested="List_ContextRequested"
                            ItemTemplate="{StaticResource SearchArtistCardTemplate}"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0,0,16,0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="AllAlbumsSection" Spacing="12">
                        <TextBlock Text="Albums" FontSize="28" FontWeight="SemiBold" />
                        <ListView
                            x:Name="AllAlbumsList"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="Album_ItemClick"
                            ContextRequested="List_ContextRequested"
                            ItemTemplate="{StaticResource SearchAlbumCardTemplate}"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0,0,16,0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="AllSongsSection" Spacing="12">
                        <TextBlock Text="Songs" FontSize="28" FontWeight="SemiBold" />
                        <!-- The outer ScrollViewer scrolls; this list only
                             ever holds the top matches, so rendering all rows
                             without its own scrolling is fine. -->
                        <ListView
                            x:Name="AllSongsList"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="SongsList_ItemClick"
                            ContextRequested="List_ContextRequested"
                            ItemTemplate="{StaticResource SearchSongRowTemplate}"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Artists scope: the browse-grid layout, incrementally paged. -->
            <GridView
                x:Name="ArtistsScopeGrid"
                XYFocusUp="{x:Bind FilterArtistsButton}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Artist_ItemClick"
                ContextRequested="List_ContextRequested"
                ItemTemplate="{StaticResource SearchArtistCardTemplate}"
                Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,20,20" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <!-- Albums scope. -->
            <GridView
                x:Name="AlbumsScopeGrid"
                XYFocusUp="{x:Bind FilterAlbumsButton}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Album_ItemClick"
                ContextRequested="List_ContextRequested"
                ItemTemplate="{StaticResource SearchAlbumCardTemplate}"
                Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,20,20" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
            </GridView>

            <!-- Songs scope: the Songs-browse column layout with headers. -->
            <Grid x:Name="SongsScopePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16" Padding="12,0,12,10" Opacity="0.6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Artist" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Album" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Length" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Format" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Bitrate" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                </Grid>

                <ListView
                    x:Name="SongsScopeList"
                    Grid.Row="1"
                    XYFocusUp="{x:Bind FilterSongsButton}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="SongsList_ItemClick"
                    ContextRequested="List_ContextRequested"
                    ItemTemplate="{StaticResource SearchSongRowTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
