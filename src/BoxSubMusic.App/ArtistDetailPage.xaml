<Page
    x:Class="BoxSubMusic.App.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Artist detail (Slice 06a, requirements §8): large artwork, name,
         favorite heart (persisted via star/unstar), album + song counts, and
         the lower album grid. Play/Shuffle are shown disabled with an explicit
         note because queue playback lands in Slice 06b after the now-playing
         bar exists (§15: no silent degradation). -->
    <Grid>
        <ScrollViewer x:Name="ContentScroller" Visibility="Collapsed" Padding="48,36,48,36">
            <StackPanel Spacing="36">
                <!-- Header: artwork + metadata. -->
                <Grid ColumnSpacing="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="320" Height="320" CornerRadius="12">
                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <FontIcon
                                FontFamily="{StaticResource FluentIconFont}"
                                Glyph="&#xF5A9;"
                                FontSize="96"
                                Opacity="0.4" />
                        </Border>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                        <TextBlock
                            x:Name="ArtistNameText"
                            FontSize="56"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <!-- XYFocusDown: Play/Shuffle below are disabled
                                 (unfocusable) until Slice 10, so gamepad down
                                 is pinned to the album grid instead of the XY
                                 engine's fallback (which could stray to the
                                 nav pane — console finding 2026-07-14). -->
                            <ToggleButton
                                x:Name="FavoriteToggle"
                                MinWidth="0"
                                Padding="12"
                                Checked="FavoriteToggle_Changed"
                                Unchecked="FavoriteToggle_Changed"
                                XYFocusDown="{x:Bind AlbumsGrid}"
                                ToolTipService.ToolTip="Favorite">
                                <FontIcon
                                    x:Name="FavoriteIcon"
                                    FontFamily="{StaticResource FluentIconFont}"
                                    Glyph="&#xF47A;"
                                    FontSize="28" />
                            </ToggleButton>
                            <TextBlock
                                x:Name="FavoriteStatusText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Opacity="0.8"
                                Visibility="Collapsed"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="CountsText"
                            FontSize="22"
                            Opacity="0.8" />

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <!-- Play/Shuffle land in Slice 06b (queue + now-playing
                                 bar). Disabled and labelled so the §8 layout is
                                 faithful and the deferral is visible. -->
                            <Button x:Name="PlayButton" IsEnabled="False" Padding="28,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="20" />
                                    <TextBlock Text="Play" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShuffleButton" IsEnabled="False" Padding="28,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="20" />
                                    <TextBlock Text="Shuffle" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Text="Playback arrives in a later update."
                            FontSize="15"
                            Opacity="0.6"
                            FontStyle="Italic" />
                    </StackPanel>
                </Grid>

                <!-- Lower album grid, matching the browse-view card style (§8). -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Albums" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="NoAlbumsText"
                        Text="No albums for this artist."
                        FontSize="20"
                        Opacity="0.7"
                        Visibility="Collapsed" />
                    <GridView
                        x:Name="AlbumsGrid"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Album_ItemClick">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,20,20" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlbumCard">
                                <StackPanel Width="200" Spacing="8">
                                    <Grid Width="200" Height="200" CornerRadius="8">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                            <FontIcon
                                                FontFamily="{StaticResource FluentIconFont}"
                                                Glyph="&#xE855;"
                                                FontSize="64"
                                                Opacity="0.4" />
                                        </Border>
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind ArtworkUri}" DecodePixelWidth="400" />
                                            </Image.Source>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <StackPanel
            x:Name="ErrorPanel"
            Visibility="Collapsed"
            Spacing="16"
            MaxWidth="820"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="ErrorText"
                FontSize="22"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <Button
                x:Name="RetryButton"
                Content="Retry"
                FontSize="20"
                Padding="40,10"
                HorizontalAlignment="Center"
                Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Page>
