<Page
    x:Class="BoxSubMusic.App.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Artist detail (Slices 06a + 06b, requirements §8): large artwork,
         name, favorite heart (persisted via star/unstar), album + song
         counts, and the lower album grid. Since Slice 10 the deferred 06b
         behavior is live: Play queues every song oldest-album-first, Shuffle
         queues the same pool randomized — both replace the current queue. -->
    <Grid>
        <!-- The album grid IS the page's scroll host, and everything above it
             is its Header — deliberately not a ScrollViewer wrapping both.
             An items control measured inside a ScrollViewer is given infinite
             height, which silently disables virtualization (§11, measured on
             console 2026-08-13). Layout and the single scroll region are
             unchanged. Do not reintroduce an enclosing ScrollViewer. -->
        <GridView
            x:Name="AlbumsGrid"
            Visibility="Collapsed"
            Padding="48,36,48,36"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="Album_ItemClick"
            ContextRequested="Albums_ContextRequested">
            <GridView.Header>
            <StackPanel Spacing="36" Margin="0,0,0,16">
                <!-- Header: artwork + metadata. -->
                <Grid ColumnSpacing="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="320" Height="320" CornerRadius="12" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <FontIcon
                                FontFamily="{StaticResource FluentIconFont}"
                                Glyph="&#xF5A9;"
                                FontSize="96"
                                Opacity="0.4" />
                        </Border>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                        <TextBlock
                            x:Name="ArtistNameText"
                            FontSize="56"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <!-- Starred = accent-filled heart with a black
                                 rim (shared FavoriteHeart; checkpoint #4
                                 redesign) — the state lives in the glyph,
                                 not the button chrome. -->
                            <controls:FavoriteHeart
                                x:Name="FavoriteToggle"
                                Padding="12"
                                GlyphSize="28"
                                Checked="FavoriteToggle_Changed"
                                Unchecked="FavoriteToggle_Changed"
                                ToolTipService.ToolTip="Favorite" />
                            <TextBlock
                                x:Name="FavoriteStatusText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Opacity="0.8"
                                Visibility="Collapsed"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="CountsText"
                            FontSize="22"
                            Opacity="0.8" />

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <!-- §8: Play = every song oldest-album-first,
                                 Shuffle = the same pool randomized; both
                                 replace the queue (live since Slice 10). The
                                 song pool needs one getAlbum per album, so the
                                 buttons disable while it is fetched and
                                 PlaybackStatusText reports a failure. -->
                            <Button x:Name="PlayButton" Style="{StaticResource RetroPrimaryButtonStyle}" Padding="28,12" Click="PlayButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="20" />
                                    <TextBlock Text="Play" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShuffleButton" Style="{StaticResource RetroTonalButtonStyle}" Padding="28,12" Click="ShuffleButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="20" />
                                    <TextBlock Text="Shuffle" FontSize="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Queue edits (2026-07-18): the container forms
                                 of "Play next"/"Add to queue" — the whole §8
                                 pool, without replacing the queue. Icon-only
                                 to keep the row from crowding; same
                                 cmap-verified glyphs as the song menus. -->
                            <Button
                                x:Name="PlayNextButton"
                                Style="{StaticResource RetroTonalButtonStyle}"
                                Padding="16,12"
                                Click="PlayNextButton_Click"
                                ToolTipService.ToolTip="Play next"
                                AutomationProperties.Name="Play next">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" FontSize="20" />
                            </Button>
                            <Button
                                x:Name="AddToQueueButton"
                                Style="{StaticResource RetroTonalButtonStyle}"
                                Padding="16,12"
                                Click="AddToQueueButton_Click"
                                ToolTipService.ToolTip="Add to queue"
                                AutomationProperties.Name="Add to queue">
                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" FontSize="20" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="PlaybackStatusText"
                            FontSize="16"
                            Opacity="0.8"
                            Visibility="Collapsed"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Lower album grid, matching the browse-view card style (§8). -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Albums" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="NoAlbumsText"
                        Text="No albums for this artist."
                        FontSize="20"
                        Opacity="0.7"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            </GridView.Header>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,20,20" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AlbumCard">
                                <StackPanel Width="200" Spacing="8">
                                    <StackPanel.ContextFlyout>
                                        <!-- Container queue edits (2026-07-18):
                                             fetches the album's songs on
                                             demand. Gamepad Menu button routed
                                             via the GridView-level redirect
                                             (console-verified pattern). -->
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Play"
                                                Tag="{x:Bind}"
                                                Click="AlbumPlay_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Text="Play next"
                                                Tag="{x:Bind}"
                                                Click="AlbumPlayNext_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Text="Add to queue"
                                                Tag="{x:Bind}"
                                                Click="AlbumAddToQueue_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                    <Grid Width="200" Height="200" CornerRadius="8" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                            <controls:VinylDisc Margin="22" />
                                        </Border>
                                        <Image Stretch="UniformToFill" controls:CachedCover.DecodeWidth="200" controls:CachedCover.SourceUri="{x:Bind ArtworkUri}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
        </GridView>

        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <StackPanel
            x:Name="ErrorPanel"
            Visibility="Collapsed"
            Spacing="16"
            MaxWidth="820"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="ErrorText"
                FontSize="22"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
            <Button
                x:Name="RetryButton"
                Style="{StaticResource RetroTonalButtonStyle}"
                Content="Retry"
                FontSize="20"
                Padding="40,10"
                HorizontalAlignment="Center"
                Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Page>
