<Page
    x:Class="BoxSubMusic.App.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Albums browse (Slice 07a, requirements §7.2): grid by default with a
         list alternate and the shared always-visible view-mode toggle (§13.5).
         Albums load A→Z in pages as the user scrolls (incremental loading,
         decision 2026-07-13). Cards open the album detail view; a
         connection/auth failure is a page-level error with Retry (§3). -->
    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + always-visible grid/list toggle (§13.5). -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock
                    Text="Albums"
                    FontSize="48"
                    FontWeight="SemiBold" />
                <controls:RetroStripes Width="150" HorizontalAlignment="Left" />
            </StackPanel>
            <controls:ViewModeToggle
                x:Name="ViewModeToggle"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ModeChanged="ViewModeToggle_Changed" />
        </Grid>

        <!-- Content states share row 1; only one is visible at a time. -->
        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                Text="This server has no albums."
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <!-- Default mode: grid. -->
            <GridView
                x:Name="AlbumsGrid"
                XYFocusUp="{x:Bind ViewModeToggle.FocusTarget}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Album_ItemClick"
                ContextRequested="Albums_ContextRequested"
                Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,20,20" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumCard">
                        <StackPanel Width="200" Spacing="8">
                            <StackPanel.ContextFlyout>
                                <!-- Container queue edits (2026-07-18): the
                                     album's songs are fetched on demand.
                                     Gamepad Menu button routed via the
                                     view-level redirect (console-verified). -->
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="Play"
                                        Tag="{x:Bind}"
                                        Click="AlbumPlay_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Play next"
                                        Tag="{x:Bind}"
                                        Click="AlbumPlayNext_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Add to queue"
                                        Tag="{x:Bind}"
                                        Click="AlbumAddToQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Grid Width="200" Height="200" CornerRadius="8" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                                <!-- Vinyl-disc placeholder (retro theme, 2026-07-19). -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <controls:VinylDisc Margin="22" />
                                </Border>
                                <Image Stretch="UniformToFill" controls:CachedCover.DecodeWidth="200" controls:CachedCover.SourceUri="{x:Bind ArtworkUri}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Alternate mode: list. -->
            <ListView
                x:Name="AlbumsList"
                XYFocusUp="{x:Bind ViewModeToggle.FocusTarget}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Album_ItemClick"
                ContextRequested="Albums_ContextRequested">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumCard">
                        <!-- The list row carries more than the grid tile can
                             (§7.2, 2026-07-27): artwork + name/artist on the
                             left, the starred marker, then year · genre ·
                             tracks · total play time on the right — all of it
                             already in the getAlbumList2 response. -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="Play"
                                        Tag="{x:Bind}"
                                        Click="AlbumPlay_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Play next"
                                        Tag="{x:Bind}"
                                        Click="AlbumPlayNext_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Add to queue"
                                        Tag="{x:Bind}"
                                        Click="AlbumAddToQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid Grid.Column="0" Width="56" Height="56" CornerRadius="6" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <controls:VinylDisc Margin="6" />
                                </Border>
                                <Image Stretch="UniformToFill" controls:CachedCover.DecodeWidth="56" controls:CachedCover.SourceUri="{x:Bind ArtworkUri}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- Starred marker, same filled accent heart the
                                 song lists use (checkpoint #4). -->
                            <FontIcon
                                Grid.Column="2"
                                FontFamily="{StaticResource FluentIconFilledFont}"
                                Glyph="&#xF47E;"
                                FontSize="16"
                                Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                Visibility="{x:Bind StarredVisibility}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind MetaLabel}"
                                Visibility="{x:Bind MetaVisibility}"
                                FontSize="18"
                                Opacity="0.75"
                                TextAlignment="Right"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
