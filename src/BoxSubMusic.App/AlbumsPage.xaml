<Page
    x:Class="BoxSubMusic.App.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Albums browse (Slice 07a, requirements §7.2): grid by default with a
         list alternate and the shared always-visible view-mode toggle (§13.5).
         Albums load A→Z in pages as the user scrolls (incremental loading,
         decision 2026-07-13). Cards open the album detail view; a
         connection/auth failure is a page-level error with Retry (§3). -->
    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + always-visible grid/list toggle (§13.5). -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock
                Text="Albums"
                FontSize="48"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <controls:ViewModeToggle
                x:Name="ViewModeToggle"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ModeChanged="ViewModeToggle_Changed" />
        </Grid>

        <!-- Content states share row 1; only one is visible at a time. -->
        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                Text="This server has no albums."
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <!-- Default mode: grid. -->
            <GridView
                x:Name="AlbumsGrid"
                XYFocusUp="{x:Bind ViewModeToggle.FocusTarget}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Album_ItemClick"
                Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,20,20" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumCard">
                        <StackPanel Width="200" Spacing="8">
                            <Grid Width="200" Height="200" CornerRadius="8">
                                <!-- Album placeholder uses the same official
                                     Fluent music-note codepoint as the Songs
                                     nav item (§13.3: never invent codepoints). -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <FontIcon
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xE855;"
                                        FontSize="64"
                                        Opacity="0.4" />
                                </Border>
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ArtworkUri}" DecodePixelWidth="400" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Alternate mode: list. -->
            <ListView
                x:Name="AlbumsList"
                XYFocusUp="{x:Bind ViewModeToggle.FocusTarget}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Album_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumCard">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Grid Width="56" Height="56" CornerRadius="6">
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <FontIcon
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xE855;"
                                        FontSize="24"
                                        Opacity="0.4" />
                                </Border>
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ArtworkUri}" DecodePixelWidth="112" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Artist}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
