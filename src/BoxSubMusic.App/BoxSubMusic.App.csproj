<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\BoxSubMusic.Core\BoxSubMusic.Core.csproj" />
    <ProjectReference Include="..\BoxSubMusic.SubsonicClient\BoxSubMusic.SubsonicClient.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- Native AOT cross-compilation (ARM64 build host -> x64 Xbox target):
       MUST build with the arm64-native MSBuild
       (MSBuild\Current\Bin\arm64\MSBuild.exe). The default MSBuild.exe runs
       x64-emulated and mis-detects the AOT host architecture, breaking
       ILCompiler pack resolution. See CLAUDE.local.md. -->
</Project>