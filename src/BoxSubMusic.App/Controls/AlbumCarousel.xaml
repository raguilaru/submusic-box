<UserControl
    x:Class="BoxSubMusic.App.Controls.AlbumCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:local="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- One Home carousel row (requirements §6.2–§6.4): non-looping
         horizontal album strip with loading / empty / error states. The
         horizontal ItemsStackPanel virtualizes and does not wrap around, so
         non-looping comes by construction. Clicking a card raises
         AlbumClicked; the host page navigates to the album detail view
         (Slice 07a). -->
    <StackPanel Spacing="12">
        <TextBlock
            x:Name="TitleText"
            FontSize="28"
            FontWeight="SemiBold" />
        <local:RetroStripes Width="110" HorizontalAlignment="Left" Margin="0,-6,0,0" />

        <Grid MinHeight="300">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="24,0" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                FontSize="20"
                Opacity="0.7"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ErrorPanel"
                Visibility="Collapsed"
                Spacing="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">
                <TextBlock
                    x:Name="ErrorText"
                    FontSize="20"
                    TextWrapping="Wrap"
                    MaxWidth="720" />
                <Button
                    x:Name="RetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="32,8"
                    Click="RetryButton_Click" />
            </StackPanel>

            <ListView
                x:Name="AlbumList"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="AlbumList_ItemClick"
                ContextRequested="AlbumList_ContextRequested"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- CacheLength: see App.xaml's TightItemsStack (§11). -->
                        <ItemsStackPanel Orientation="Horizontal" CacheLength="1.0" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,0,16,0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumCard">
                        <StackPanel Width="220" Spacing="6">
                            <StackPanel.ContextFlyout>
                                <!-- Container queue edits (2026-07-18): the
                                     album's songs are fetched on demand.
                                     Gamepad Menu button routed via the
                                     list-level redirect (console-verified). -->
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="Play"
                                        Tag="{x:Bind}"
                                        Click="AlbumPlay_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Play next"
                                        Tag="{x:Bind}"
                                        Click="AlbumPlayNext_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Add to queue"
                                        Tag="{x:Bind}"
                                        Click="AlbumAddToQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Grid
                                Width="220"
                                Height="220"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource RetroCardBorderBrush}"
                                BorderThickness="1">
                                <!-- Placeholder shows through until artwork
                                     loads (or when the server has none):
                                     the vinyl disc (retro theme). -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <local:VinylDisc Margin="24" />
                                </Border>
                                <Image Stretch="UniformToFill" local:CachedCover.DecodeWidth="220" local:CachedCover.SourceUri="{x:Bind ArtworkUri}" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontSize="20"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Artist}"
                                FontSize="16"
                                Opacity="0.7"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </StackPanel>
</UserControl>
