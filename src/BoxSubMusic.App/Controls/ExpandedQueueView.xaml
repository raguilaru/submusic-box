<UserControl
    x:Class="BoxSubMusic.App.Controls.ExpandedQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App.Controls"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Expanded queue (Slice 11, requirements §10): a full-screen overlay
         that slides up over the whole shell — two panes, playback controls +
         rich metadata on the left, the full queue in play order on the
         right. A/Enter on a queue row jumps playback directly to that entry;
         B / Y / the chevron button collapse it. The host (MainPage) traps
         focus by disabling the shell underneath while this is open. -->
    <UserControl.Resources>
        <Style x:Key="OverlayTransportButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Segmented Queue / Lyrics tabs on the right pane. Retro checked
             visuals come from the App.xaml ToggleButton-checked overrides.
             Padding widened 2026-07-27: at 18,8 the checked pill's fill ran
             close to its own label and to the neighbouring tab, so the strip
             read as one crowded block at 10 ft. -->
        <Style x:Key="PaneTabToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="26,10" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Visibility="Collapsed"
        KeyDown="Root_KeyDown"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" />
        </Grid.RenderTransform>
        <Grid.Resources>
            <!-- §10: the expanded/collapsed state animates with a slide.
                 The vertical From/To are set in code from the actual view
                 height before each Begin. -->
            <Storyboard x:Name="OpenStoryboard">
                <DoubleAnimation
                    x:Name="OpenTranslate"
                    Storyboard.TargetName="RootTransform"
                    Storyboard.TargetProperty="Y"
                    From="1080"
                    To="0"
                    Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.3" />
            </Storyboard>
            <Storyboard x:Name="CloseStoryboard">
                <DoubleAnimation
                    x:Name="CloseTranslate"
                    Storyboard.TargetName="RootTransform"
                    Storyboard.TargetProperty="Y"
                    From="0"
                    To="1080"
                    Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.25" />
            </Storyboard>
        </Grid.Resources>

        <Grid Padding="64,40,64,44" ColumnSpacing="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left pane (§10): rich metadata + the full transport cluster.
                 Same control set as the compact bar, larger. -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="24">
                <Grid Width="400" Height="400" CornerRadius="12" HorizontalAlignment="Left" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                    <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                        <local:VinylDisc Margin="40" />
                    </Border>
                    <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="34"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ArtistAlbumText"
                        FontSize="22"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="StreamInfoText"
                        FontSize="17"
                        Opacity="0.55" />
                </StackPanel>

                <!-- Elapsed — progress — total (display only, like the bar). -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" Grid.Column="0" FontSize="18" Opacity="0.8" Text="0:00" />
                    <ProgressBar
                        x:Name="TrackProgress"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource RetroCreamBrush}"
                        Maximum="1"
                        Value="0" />
                    <TextBlock x:Name="TotalText" Grid.Column="2" FontSize="18" Opacity="0.8" Text="0:00" />
                </Grid>

                <!-- Transport: shuffle · previous · play/pause · next ·
                     repeat · favorite. Neighbors pinned with XYFocus hints —
                     the console-verified pattern from the compact bar. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleButton
                        x:Name="ShuffleToggle"
                        MinWidth="0"
                        Width="56"
                        Height="56"
                        Padding="0"
                        CornerRadius="28"
                        Background="Transparent"
                        Checked="ShuffleToggle_Changed"
                        Unchecked="ShuffleToggle_Changed"
                        XYFocusRight="{x:Bind PreviousButton}"
                        ToolTipService.ToolTip="Shuffle"
                        AutomationProperties.Name="Shuffle">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="22" />
                    </ToggleButton>
                    <Button
                        x:Name="PreviousButton"
                        Style="{StaticResource OverlayTransportButton}"
                        Click="PreviousButton_Click"
                        XYFocusLeft="{x:Bind ShuffleToggle}"
                        XYFocusRight="{x:Bind PlayPauseButton}"
                        ToolTipService.ToolTip="Previous"
                        AutomationProperties.Name="Previous">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF629;" FontSize="22" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        MinWidth="0"
                        Width="72"
                        Height="72"
                        Padding="0"
                        CornerRadius="36"
                        Background="{ThemeResource RetroCreamBrush}"
                        Foreground="{ThemeResource RetroOnCreamBrush}"
                        Click="PlayPauseButton_Click"
                        XYFocusLeft="{x:Bind PreviousButton}"
                        XYFocusRight="{x:Bind NextButton}"
                        ToolTipService.ToolTip="Play/Pause"
                        AutomationProperties.Name="Play or pause">
                        <FontIcon x:Name="PlayPauseIcon" FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="30" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Style="{StaticResource OverlayTransportButton}"
                        Click="NextButton_Click"
                        XYFocusLeft="{x:Bind PlayPauseButton}"
                        XYFocusRight="{x:Bind RepeatButton}"
                        ToolTipService.ToolTip="Next"
                        AutomationProperties.Name="Next">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" FontSize="22" />
                    </Button>
                    <Button
                        x:Name="RepeatButton"
                        Style="{StaticResource OverlayTransportButton}"
                        Click="RepeatButton_Click"
                        XYFocusLeft="{x:Bind NextButton}"
                        XYFocusRight="{x:Bind FavoriteToggle}"
                        ToolTipService.ToolTip="Repeat"
                        AutomationProperties.Name="Repeat">
                        <FontIcon x:Name="RepeatIcon" FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF172;" FontSize="22" Opacity="0.45" />
                    </Button>
                    <local:FavoriteHeart
                        x:Name="FavoriteToggle"
                        Width="56"
                        Height="56"
                        Padding="0"
                        CornerRadius="28"
                        GlyphSize="22"
                        Checked="FavoriteToggle_Changed"
                        Unchecked="FavoriteToggle_Changed"
                        XYFocusLeft="{x:Bind RepeatButton}"
                        ToolTipService.ToolTip="Favorite"
                        AutomationProperties.Name="Favorite" />
                </StackPanel>
            </StackPanel>

            <!-- Right pane (§10): the full queue in current play order. -->
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header row. Column spacing and the title stack's spacing
                     were both opened up 2026-07-27: the tab strip, the stripe
                     motif and the context line sat almost flush against each
                     other, and the two right-hand buttons crowded the tabs. -->
                <Grid Grid.Row="0" ColumnSpacing="24" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="12">
                        <!-- Single-mode title, shown when the server has no
                             songLyrics extension (the Lyrics tab is hidden). -->
                        <TextBlock
                            x:Name="HeaderTitleText"
                            Text="Queue"
                            FontSize="32"
                            FontWeight="SemiBold" />
                        <!-- Queue / Lyrics segmented tabs, shown when lyrics
                             are supported. Exclusivity is enforced in code.
                             The LB/RB badges flank the pair (LB = left tab =
                             Queue, RB = right tab = Lyrics): the shoulder
                             buttons switch tabs from anywhere in the overlay
                             (Root_KeyDown), so the mapping is advertised right
                             on the titles. -->
                        <StackPanel
                            x:Name="TabStrip"
                            Orientation="Horizontal"
                            Spacing="18"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <local:ControllerGlyph Label="LB" VerticalAlignment="Center" Opacity="0.65" />
                            <ToggleButton
                                x:Name="QueueTabButton"
                                Style="{StaticResource PaneTabToggle}"
                                Content="Queue"
                                IsChecked="True"
                                Click="QueueTabButton_Click"
                                XYFocusRight="{x:Bind LyricsTabButton}"
                                AutomationProperties.Name="Queue tab (LB)" />
                            <ToggleButton
                                x:Name="LyricsTabButton"
                                Style="{StaticResource PaneTabToggle}"
                                Content="Lyrics"
                                Click="LyricsTabButton_Click"
                                XYFocusLeft="{x:Bind QueueTabButton}"
                                AutomationProperties.Name="Lyrics tab (RB)" />
                            <local:ControllerGlyph Label="RB" VerticalAlignment="Center" Opacity="0.65" />
                        </StackPanel>
                        <local:RetroStripes Width="110" HorizontalAlignment="Left" />
                        <TextBlock
                            x:Name="QueueContextText"
                            FontSize="18"
                            Opacity="0.7"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Return affordance in Lyrics mode: appears once the user
                         has read away from the current line, and brings the
                         view back WITHOUT moving playback (A on a line seeks
                         instead, so this stays the non-destructive way back). -->
                    <Button
                        x:Name="JumpToCurrentButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Padding="14,8"
                        CornerRadius="18"
                        FontSize="16"
                        Visibility="Collapsed"
                        Content="Jump to current line"
                        Click="JumpToCurrentButton_Click"
                        AutomationProperties.Name="Jump to current line" />
                    <!-- Collapse affordance: gamepad users have B/Y, but
                         keyboard/mouse need a visible exit (§13.1). Chevron
                         F2A4 verified against the shipped Regular TTF cmap. -->
                    <Button
                        x:Name="CollapseButton"
                        Grid.Column="2"
                        Style="{StaticResource OverlayTransportButton}"
                        VerticalAlignment="Top"
                        Click="CollapseButton_Click"
                        ToolTipService.ToolTip="Collapse queue"
                        AutomationProperties.Name="Collapse queue">
                        <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF2A4;" FontSize="22" />
                    </Button>
                </Grid>

                <!-- Row 1 body: the Queue list and the Lyrics list occupy the
                     same cell; the tab toggle swaps which one is visible. -->
                <Grid Grid.Row="1">
                <!-- Rows mirror the album track list's visual language:
                     position column swaps to the accent now-playing marker,
                     starred songs carry the small filled heart. -->
                <ListView
                    x:Name="QueueList"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="QueueList_ItemClick"
                    ContextRequested="QueueList_ContextRequested"
                    ContainerContentChanging="QueueList_ContainerContentChanging">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueRow">
                            <Grid ColumnSpacing="16" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <!-- Queue-row secondary actions (Slice 14 —
                                         the refinement deferred out of Slice
                                         11). Same console-verified redirect
                                         pattern and §13.3 cmap-verified icons
                                         as every other song-row menu; no
                                         queue-edit items here (the row is
                                         already IN the queue). "Go to" closes
                                         the overlay before navigating. -->
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="Play"
                                            Tag="{x:Bind}"
                                            Click="PlaySong_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Text="{x:Bind FavoriteLabel, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="ToggleFavorite_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF47A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Text="Go to album"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind HasAlbumId}"
                                            Click="GoToAlbum_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE010;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Text="Go to artist"
                                            Tag="{x:Bind}"
                                            IsEnabled="{x:Bind HasArtistId}"
                                            Click="GoToArtist_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF5BE;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind Position}"
                                    FontSize="20"
                                    Opacity="0.6"
                                    TextAlignment="Right" />
                                <local:SpinningVinyl
                                    Grid.Column="0"
                                    Width="26"
                                    Height="26"
                                    Visibility="{x:Bind NowPlayingVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Title}"
                                    FontSize="20"
                                    TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    Grid.Column="2"
                                    FontFamily="{StaticResource FluentIconFilledFont}"
                                    Glyph="&#xF47E;"
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                    Visibility="{x:Bind StarredVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind Artist}"
                                    FontSize="18"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="360" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind DurationLabel}"
                                    FontSize="20"
                                    Opacity="0.6"
                                    TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Lyrics list (§songLyrics). Synced lines auto-scroll and
                     highlight; D-pad reads ahead/back and pauses the follow,
                     and A/Enter on a line seeks playback to it (§10.1,
                     2026-07-26). Unsynced lyrics carry no times, so there A
                     falls back to re-centering on the current line.
                     The message shows the loading / no-lyrics states instead. -->
                <Grid x:Name="LyricsPanel" Visibility="Collapsed">
                    <ListView
                        x:Name="LyricsList"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="LyricsList_ItemClick"
                        KeyDown="LyricsList_KeyDown"
                        ContainerContentChanging="QueueList_ContainerContentChanging"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LyricLineRow">
                                <Grid Background="Transparent" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Accent marker bar on the active line —
                                         the fixed gutter keeps text from jogging
                                         as the highlight moves. Colour via
                                         ThemeResource stays theme-correct. -->
                                    <Rectangle
                                        Grid.Column="0"
                                        Width="4"
                                        Height="26"
                                        RadiusX="2"
                                        RadiusY="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemControlForegroundAccentBrush}"
                                        Visibility="{x:Bind MarkerVisibility, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Text}"
                                        FontSize="24"
                                        TextWrapping="Wrap"
                                        FontWeight="{x:Bind LineWeight, Mode=OneWay}"
                                        Opacity="{x:Bind LineOpacity, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="LyricsMessage"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        FontSize="20"
                        Opacity="0.7"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
                </Grid>

                <!-- Controller hints as monochrome button badges (checkpoint
                     #7 request, 2026-07-18 — replaces the static sentence).
                     Swapped by pane mode: the queue is jump + menu, the lyrics
                     tab is seek-to-line (synced lyrics only). -->
                <StackPanel x:Name="QueueHints" Grid.Row="2" Orientation="Horizontal" Spacing="8" Opacity="0.7">
                    <local:ControllerGlyph Label="A" />
                    <TextBlock Text="Jump to song" FontSize="15" VerticalAlignment="Center" />
                    <local:ControllerGlyph Label="Menu" Margin="16,0,0,0" />
                    <TextBlock Text="More options" FontSize="15" VerticalAlignment="Center" />
                    <local:ControllerGlyph Label="Y" Margin="16,0,0,0" />
                    <local:ControllerGlyph Label="B" />
                    <TextBlock Text="Close queue" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="LyricsHints" Grid.Row="2" Orientation="Horizontal" Spacing="8" Opacity="0.7" Visibility="Collapsed">
                    <!-- Only meaningful for synced lyrics — hidden for
                         unsynced/no-lyrics, which carry no timestamps to
                         seek to. -->
                    <StackPanel x:Name="LyricsSeekHint" Orientation="Horizontal" Spacing="8">
                        <local:ControllerGlyph Label="A" />
                        <TextBlock Text="Play from line" FontSize="15" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </StackPanel>
                    <local:ControllerGlyph Label="Y" />
                    <local:ControllerGlyph Label="B" />
                    <TextBlock Text="Close queue" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
