<UserControl
    x:Class="BoxSubMusic.App.Controls.ViewModeToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The one grid/list view-mode toggle (requirements §13.5): every browse
         view with dual modes uses this control, so the affordance looks and
         behaves identically everywhere. Unchecked = grid (the §7 default),
         checked = list. The face advertises the CURRENT mode. -->
    <ToggleButton
        x:Name="Toggle"
        MinWidth="140"
        Padding="16,8"
        Checked="Toggle_Changed"
        Unchecked="Toggle_Changed"
        ToolTipService.ToolTip="Switch between grid and list view">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- Verified Fluent codepoints: grid U+F463, list U+F4EE (§13.3). -->
            <FontIcon
                x:Name="ModeIcon"
                FontFamily="{StaticResource FluentIconFont}"
                FontSize="20"
                Glyph="&#xF463;" />
            <TextBlock x:Name="ModeLabel" Text="Grid" FontSize="18" VerticalAlignment="Center" />
        </StackPanel>
    </ToggleButton>
</UserControl>
