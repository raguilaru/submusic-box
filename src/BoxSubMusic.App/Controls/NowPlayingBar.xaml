<UserControl
    x:Class="BoxSubMusic.App.Controls.NowPlayingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Persistent now-playing bar (Slice 10, requirements §10): artwork,
         title, artist, album, format, bitrate, elapsed/total time, and the
         shuffle / previous / play-pause / next / repeat / queue-expand
         controls. Sits in its own layout row at the bottom of the shell's
         content area — visually floating (margins + rounded corners), but
         never overlapping page content. Collapsed until the first Play; the
         reveal slides up (§10 slide transition). The queue-expand button is
         present but disabled until Slice 11 ships the expanded view. -->
    <UserControl.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Visibility="Collapsed"
        Margin="24,8,24,16"
        Padding="20,14"
        MinHeight="112"
        CornerRadius="12"
        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="1"
        ColumnSpacing="20">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" />
        </Grid.RenderTransform>
        <Grid.Resources>
            <Storyboard x:Name="RevealStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootTransform"
                    Storyboard.TargetProperty="Y"
                    From="140"
                    To="0"
                    Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.3" />
            </Storyboard>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!-- Metadata and the time strip flex equally so the transport
                 cluster stays visually centered in the bar. -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Artwork thumbnail with the music-note placeholder behind it
             (same official Fluent codepoint as the Songs nav item). -->
        <Grid Grid.Column="0" Width="84" Height="84" CornerRadius="8" VerticalAlignment="Center">
            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <FontIcon
                    FontFamily="{StaticResource FluentIconFont}"
                    Glyph="&#xE855;"
                    FontSize="32"
                    Opacity="0.4" />
            </Border>
            <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
        </Grid>

        <!-- Title / artist · album / format · bitrate (§10 metadata). -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock
                x:Name="TitleText"
                FontSize="21"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="ArtistAlbumText"
                FontSize="16"
                Opacity="0.75"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="StreamInfoText"
                FontSize="14"
                Opacity="0.55" />
        </StackPanel>

        <!-- Transport cluster: shuffle · previous · play/pause · next ·
             repeat. Play/pause is the visual primary (larger, accent ring
             drawn by its own size — the theme's focus visuals stay). -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="10">
            <ToggleButton
                x:Name="ShuffleToggle"
                MinWidth="0"
                Width="48"
                Height="48"
                Padding="0"
                CornerRadius="24"
                Background="Transparent"
                Checked="ShuffleToggle_Changed"
                Unchecked="ShuffleToggle_Changed"
                ToolTipService.ToolTip="Shuffle"
                AutomationProperties.Name="Shuffle">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="20" />
            </ToggleButton>
            <Button
                x:Name="PreviousButton"
                Style="{StaticResource TransportButton}"
                Click="PreviousButton_Click"
                ToolTipService.ToolTip="Previous"
                AutomationProperties.Name="Previous">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF629;" FontSize="20" />
            </Button>
            <Button
                x:Name="PlayPauseButton"
                MinWidth="0"
                Width="64"
                Height="64"
                Padding="0"
                CornerRadius="32"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                Click="PlayPauseButton_Click"
                ToolTipService.ToolTip="Play/Pause"
                AutomationProperties.Name="Play or pause">
                <FontIcon x:Name="PlayPauseIcon" FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="26" />
            </Button>
            <Button
                x:Name="NextButton"
                Style="{StaticResource TransportButton}"
                Click="NextButton_Click"
                ToolTipService.ToolTip="Next"
                AutomationProperties.Name="Next">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" FontSize="20" />
            </Button>
            <Button
                x:Name="RepeatButton"
                Style="{StaticResource TransportButton}"
                Click="RepeatButton_Click"
                ToolTipService.ToolTip="Repeat"
                AutomationProperties.Name="Repeat">
                <FontIcon x:Name="RepeatIcon" FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF172;" FontSize="20" Opacity="0.45" />
            </Button>
        </StackPanel>

        <!-- Elapsed — progress — total (§10). The progress line is display
             only in v1; seeking is not a §10 requirement. -->
        <Grid Grid.Column="3" VerticalAlignment="Center" ColumnSpacing="14" MinWidth="260">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Grid.Column="0" FontSize="17" Opacity="0.8" Text="0:00" />
            <ProgressBar
                x:Name="TrackProgress"
                Grid.Column="1"
                VerticalAlignment="Center"
                Maximum="1"
                Value="0" />
            <TextBlock x:Name="TotalText" Grid.Column="2" FontSize="17" Opacity="0.8" Text="0:00" />
        </Grid>

        <!-- Queue expand (§10): control is present, the expanded two-pane
             view is Slice 11 — disabled until then, per the project's
             visible-deferral pattern. -->
        <Button
            x:Name="QueueButton"
            Grid.Column="4"
            Style="{StaticResource TransportButton}"
            VerticalAlignment="Center"
            IsEnabled="False"
            ToolTipService.ToolTip="Queue (arrives in a later update)"
            AutomationProperties.Name="Show queue (arrives in a later update)">
            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF4EE;" FontSize="20" />
        </Button>
    </Grid>
</UserControl>
