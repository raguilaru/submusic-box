<UserControl
    x:Class="BoxSubMusic.App.Controls.NowPlayingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Persistent now-playing bar (Slice 10, requirements §10): artwork,
         title, artist, album, format, bitrate, elapsed/total time, and the
         shuffle / previous / play-pause / next / repeat / queue-expand
         controls. Sits in its own layout row at the bottom of the shell's
         content area — visually floating (margins + rounded corners), but
         never overlapping page content. Collapsed until the first Play; the
         reveal slides up (§10 slide transition). The queue-expand button is
         present but disabled until Slice 11 ships the expanded view. -->
    <UserControl.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Visibility="Collapsed"
        Margin="24,8,24,16"
        Padding="20,14"
        MinHeight="112"
        CornerRadius="12"
        Background="{ThemeResource RetroSurfaceBrush}"
        BorderBrush="{ThemeResource RetroCardBorderBrush}"
        BorderThickness="1"
        ColumnSpacing="20">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" />
        </Grid.RenderTransform>
        <Grid.Resources>
            <Storyboard x:Name="RevealStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="RootTransform"
                    Storyboard.TargetProperty="Y"
                    From="140"
                    To="0"
                    Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.3" />
            </Storyboard>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!-- Metadata and the time strip flex equally so the transport
                 cluster stays visually centered in the bar. -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Artwork as a spinning vinyl record: the album art is the record
             label, and the disc rotates while the track plays (refinement
             2026-07-22). Missing art falls back to the vinyl's blank label. -->
        <local:SpinningAlbumArt
            x:Name="ArtworkVinyl"
            Grid.Column="0"
            Width="84"
            Height="84"
            VerticalAlignment="Center" />

        <!-- Title / artist · album / format · bitrate (§10 metadata). -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock
                x:Name="TitleText"
                FontSize="21"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="ArtistAlbumText"
                FontSize="16"
                Opacity="0.75"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="StreamInfoText"
                FontSize="14"
                Opacity="0.55" />
        </StackPanel>

        <!-- Transport cluster: shuffle · previous · play/pause · next ·
             repeat. Play/pause is the visual primary (larger, accent ring
             drawn by its own size — the theme's focus visuals stay).
             Left/Right neighbors are pinned with explicit XYFocus hints:
             console checkpoint #4 found the XY engine jumping from bar
             buttons into the nav pane instead of the adjacent button. -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="10">
            <ToggleButton
                x:Name="ShuffleToggle"
                MinWidth="0"
                Width="48"
                Height="48"
                Padding="0"
                CornerRadius="24"
                Background="Transparent"
                Checked="ShuffleToggle_Changed"
                Unchecked="ShuffleToggle_Changed"
                XYFocusRight="{x:Bind PreviousButton}"
                ToolTipService.ToolTip="Shuffle"
                AutomationProperties.Name="Shuffle">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xEF37;" FontSize="20" />
            </ToggleButton>
            <Button
                x:Name="PreviousButton"
                Style="{StaticResource TransportButton}"
                Click="PreviousButton_Click"
                XYFocusLeft="{x:Bind ShuffleToggle}"
                XYFocusRight="{x:Bind PlayPauseButton}"
                ToolTipService.ToolTip="Previous"
                AutomationProperties.Name="Previous">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF629;" FontSize="20" />
            </Button>
            <Button
                x:Name="PlayPauseButton"
                MinWidth="0"
                Width="64"
                Height="64"
                Padding="0"
                CornerRadius="32"
                Background="{ThemeResource RetroCreamBrush}"
                Foreground="{ThemeResource RetroOnCreamBrush}"
                Click="PlayPauseButton_Click"
                XYFocusLeft="{x:Bind PreviousButton}"
                XYFocusRight="{x:Bind NextButton}"
                ToolTipService.ToolTip="Play/Pause"
                AutomationProperties.Name="Play or pause">
                <FontIcon x:Name="PlayPauseIcon" FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" FontSize="26" />
            </Button>
            <Button
                x:Name="NextButton"
                Style="{StaticResource TransportButton}"
                Click="NextButton_Click"
                XYFocusLeft="{x:Bind PlayPauseButton}"
                XYFocusRight="{x:Bind RepeatButton}"
                ToolTipService.ToolTip="Next"
                AutomationProperties.Name="Next">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF56A;" FontSize="20" />
            </Button>
            <Button
                x:Name="RepeatButton"
                Style="{StaticResource TransportButton}"
                Click="RepeatButton_Click"
                XYFocusLeft="{x:Bind NextButton}"
                XYFocusRight="{x:Bind FavoriteToggle}"
                ToolTipService.ToolTip="Repeat"
                AutomationProperties.Name="Repeat">
                <FontIcon x:Name="RepeatIcon" FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF172;" FontSize="20" Opacity="0.45" />
            </Button>
        </StackPanel>

        <!-- Elapsed — progress — total (§10). The progress line is display
             only in v1; seeking is not a §10 requirement. -->
        <Grid Grid.Column="3" VerticalAlignment="Center" ColumnSpacing="14" MinWidth="260">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Grid.Column="0" FontSize="17" Opacity="0.8" Text="0:00" />
            <ProgressBar
                x:Name="TrackProgress"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource RetroCreamBrush}"
                Maximum="1"
                Value="0" />
            <TextBlock x:Name="TotalText" Grid.Column="2" FontSize="17" Opacity="0.8" Text="0:00" />
        </Grid>

        <!-- Utility cluster: favorite heart for the current track (console
             checkpoint #4 request; same star/unstar + checked-visuals
             pattern as the detail pages — the glyph is never painted) and
             the queue expand (§10): live since Slice 11 — raises
             QueueExpandRequested; the shell opens the overlay (also mapped
             to Y there). -->
        <StackPanel
            Grid.Column="4"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="10">
            <local:FavoriteHeart
                x:Name="FavoriteToggle"
                Width="48"
                Height="48"
                Padding="0"
                CornerRadius="24"
                GlyphSize="20"
                Checked="FavoriteToggle_Changed"
                Unchecked="FavoriteToggle_Changed"
                XYFocusLeft="{x:Bind RepeatButton}"
                XYFocusRight="{x:Bind LyricsButton}"
                ToolTipService.ToolTip="Favorite"
                AutomationProperties.Name="Favorite" />
            <!-- Lyrics (§13.3 microphone, cmap-verified U+E7FA — a plain,
                 larger mic reads clearly at bar size; the book+mic glyph was
                 indistinct): opens the Now-Playing overlay straight to the
                 Lyrics tab. Collapsed when the server lacks the songLyrics
                 extension (explicit degrade-by-hiding, §3) — set on Update. -->
            <Button
                x:Name="LyricsButton"
                Style="{StaticResource TransportButton}"
                Visibility="Collapsed"
                Click="LyricsButton_Click"
                XYFocusLeft="{x:Bind FavoriteToggle}"
                XYFocusRight="{x:Bind QueueButton}"
                ToolTipService.ToolTip="Lyrics"
                AutomationProperties.Name="Show lyrics">
                <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE7FA;" FontSize="24" />
            </Button>
            <!-- Queue button with an on-control (Y) key badge (2026-07-22
                 request): Y opens the queue globally, so co-locating the key
                 on its own button is the clearest mapping. The badge sits at
                 the BOTTOM-right corner — clear of the View label in the top
                 strip above — scaled down via a Viewbox and hit-test-invisible
                 so it never intercepts the button's own input. -->
            <Grid>
                <Button
                    x:Name="QueueButton"
                    Style="{StaticResource TransportButton}"
                    Click="QueueButton_Click"
                    XYFocusLeft="{x:Bind LyricsButton}"
                    ToolTipService.ToolTip="Queue (Y)"
                    AutomationProperties.Name="Show queue">
                    <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF4EE;" FontSize="20" />
                </Button>
                <Viewbox
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,-3,-3"
                    Opacity="0.85"
                    IsHitTestVisible="False">
                    <local:ControllerGlyph Label="Y" />
                </Viewbox>
            </Grid>
        </StackPanel>

        <!-- Jump-here indicator (2026-07-22 request): the View button jumps
             focus straight to this bar from anywhere in the shell. A subtle
             non-focusable badge in the top-right corner advertises the
             shortcut — it sits over the free space above the vertically-centred
             time/utility clusters, so it crowds nothing. -->
        <StackPanel
            Grid.Column="3"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            Spacing="6"
            Opacity="0.55"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,-6,0,0">
            <local:ControllerGlyph Label="View" />
            <TextBlock
                Text="Now playing"
                FontSize="13"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
