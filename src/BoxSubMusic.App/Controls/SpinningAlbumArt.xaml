<UserControl
    x:Class="BoxSubMusic.App.Controls.SpinningAlbumArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    IsTabStop="False">

    <!-- Now-playing-bar artwork as a spinning vinyl record (refinement,
         2026-07-22 — Rafael's request): the album art is the record LABEL in
         the centre of a vinyl disc, and the whole disc rotates while the track
         is playing, freezing in place when paused/stopped.

         Why this reads well where the tiny SpinningVinyl marker needed a
         stripe: real album art is NOT rotationally symmetric, so its rotation
         is plainly visible at bar size — no motion "tell" overlay is needed.
         The spindle hole punched through the centre gives the eye a fixed
         anchor the art turns around.

         Anatomy (drawn at 120 in a Viewbox so it scales to the 84-epx bar
         slot): near-black vinyl body + edge rim highlight (defines the record
         on a dark bar) + three groove rings in the rim zone OUTSIDE the label
         + the album-art label (a teal "blank label" shows through when the art
         is missing or still loading) + a hairline that separates art from
         vinyl + the spindle hole. All Retro* theme brushes, matching VinylDisc
         and SpinningVinyl.

         The storyboard targets the RenderTransform via the documented
         independent-animation path AND sets EnableDependentAnimation, the same
         belt-and-braces the marker uses so it can never silently fail to
         start. The code-behind gates it on PlaybackService.IsPlaying and this
         control's own visibility. -->
    <Grid x:Name="DiscRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="SpinTransform" />
        </Grid.RenderTransform>
        <Grid.Resources>
            <Storyboard x:Name="SpinStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="DiscRoot"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                    From="0"
                    To="360"
                    Duration="0:0:6"
                    RepeatBehavior="Forever"
                    EnableDependentAnimation="True" />
            </Storyboard>
        </Grid.Resources>
        <Viewbox Stretch="Uniform">
            <Grid Width="120" Height="120">
                <Ellipse Width="120" Height="120" Fill="{ThemeResource RetroVinylBrush}" />
                <Ellipse Width="118" Height="118" Stroke="{ThemeResource RetroMarkerRimBrush}" StrokeThickness="1.5" />
                <Ellipse Width="112" Height="112" Stroke="{ThemeResource RetroVinylGrooveBrush}" StrokeThickness="1" />
                <Ellipse Width="104" Height="104" Stroke="{ThemeResource RetroVinylGrooveBrush}" StrokeThickness="1" />
                <Ellipse Width="96" Height="96" Stroke="{ThemeResource RetroVinylGrooveBrush}" StrokeThickness="1" />
                <!-- Blank-label fallback: shows through while the art is null
                     or still decoding; hidden once the art paints. -->
                <Ellipse x:Name="LabelBackground" Width="82" Height="82" Fill="{ThemeResource RetroVinylLabelBrush}" />
                <Ellipse Width="82" Height="82">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Hairline separating the art label from the vinyl body. -->
                <Ellipse Width="82" Height="82" Stroke="{ThemeResource RetroVinylBrush}" StrokeThickness="1" Opacity="0.5" />
                <Ellipse Width="9" Height="9" Fill="{ThemeResource RetroVinylHoleBrush}" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
