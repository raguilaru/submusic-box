<Application
    x:Class="BoxSubMusic.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Rounded floating nav pane (console checkpoint #8 request,
                 2026-07-19): the OS NavigationView paints its pane background
                 rectangularly, so the pane's own brushes are silenced here and
                 MainPage draws a rounded backdrop (radius 12, matching the
                 now-playing bar) behind the pane instead. These brushes live
                 in generic.xaml's THEME dictionaries, which is the one
                 resource class app-side overrides reliably reach — unlike
                 the global-scope Thickness lesson below. -->
            <!-- Retro theme (UI round 2026-07-19, direction confirmed with
                 Rafael): the SubMusic Box logo's palette — petrol teal,
                 seafoam, warm cream/parchment on charcoal — replaces the
                 console accent color app-wide (§13.2/§16). Two override
                 classes, both console-proven reachable:
                 - Retro* keys are the app's own brushes (markers, surfaces,
                   stripes, card frames).
                 - System/control brush keys (SystemControlForegroundAccent,
                   ToggleButton checked, RadioButton checked) are theme-
                   dictionary overrides — templates reference them via
                   ThemeResource, the one resource class app-side overrides
                   reliably reach (the NavigationView pane-brush lesson).
                 SystemAccentColor itself is overridden for code reads
                 (FavoriteHeart); framework-internal brushes composed from it
                 in generic.xaml scope are NOT expected to follow (the
                 global-scope lesson) — the keys below cover those paths. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

                    <!-- Page ground (2026-07-27 light round): pages no longer
                         paint ApplicationPageBackgroundThemeBrush themselves —
                         the shell paints this once behind everything, so the
                         ambient watermark can sit under the content frame.
                         Dark keeps the black the console pass approved; it is
                         only the light half that changes (see below). -->
                    <SolidColorBrush x:Key="RetroPageBackgroundBrush" Color="#FF000000" />
                    <!-- Record grooves drawn faintly across the empty right of
                         the shell. Alpha does the work — the value is the
                         accent, so the motif is on-palette in both themes. -->
                    <SolidColorBrush x:Key="RetroWatermarkBrush" Color="#127FADA9" />
                    <!-- Frame around the floating pane/bar cards. On dark the
                         surface already separates from black on its own, so
                         this stays invisible there. -->
                    <SolidColorBrush x:Key="RetroPaneBorderBrush" Color="Transparent" />

                    <!-- Seafoam accent on dark (from the logo's lower "S" stripes). -->
                    <Color x:Key="SystemAccentColor">#FF7FADA9</Color>
                    <Color x:Key="RetroAccentColor">#FF7FADA9</Color>
                    <SolidColorBrush x:Key="RetroAccentBrush" Color="#FF7FADA9" />
                    <!-- Warm parchment (the logo's cream) — progress fills,
                         selected pills, stripe #1. -->
                    <SolidColorBrush x:Key="RetroCreamBrush" Color="#FFE9DCC0" />
                    <!-- Petrol sleeve teal — nav pane backdrop + playback surfaces. -->
                    <SolidColorBrush x:Key="RetroSurfaceBrush" Color="#FF253B3F" />
                    <!-- Worn-paper tan at low opacity — browse card frames. -->
                    <SolidColorBrush x:Key="RetroCardBorderBrush" Color="#59C8B694" />
                    <!-- The triple-stripe motif, cream → seafoam like the "S". -->
                    <SolidColorBrush x:Key="RetroStripeBrush1" Color="#FFE9DCC0" />
                    <SolidColorBrush x:Key="RetroStripeBrush2" Color="#FFA9C2BE" />
                    <SolidColorBrush x:Key="RetroStripeBrush3" Color="#FF7FADA9" />
                    <!-- Ink for content sitting ON a cream fill (play/pause). -->
                    <SolidColorBrush x:Key="RetroOnCreamBrush" Color="#FF1E1E1C" />
                    <!-- Detail-view action buttons (Play/Shuffle/queue edits).
                         Primary = the cream play/pause fill so the detail Play
                         button reads as the same primary action as the bar's;
                         tonal = a translucent seafoam chip with accent ink for
                         Shuffle and the icon-only queue edits. Hover/pressed
                         brushes keep the states on-palette instead of the
                         generic grey chrome. -->
                    <SolidColorBrush x:Key="RetroPrimaryFillBrush" Color="#FFE9DCC0" />
                    <SolidColorBrush x:Key="RetroPrimaryFillHoverBrush" Color="#FFF2E9D3" />
                    <SolidColorBrush x:Key="RetroPrimaryFillPressedBrush" Color="#FFD3C3A0" />
                    <SolidColorBrush x:Key="RetroPrimaryInkBrush" Color="#FF1E1E1C" />
                    <SolidColorBrush x:Key="RetroTonalFillBrush" Color="#267FADA9" />
                    <SolidColorBrush x:Key="RetroTonalFillHoverBrush" Color="#3D7FADA9" />
                    <SolidColorBrush x:Key="RetroTonalFillPressedBrush" Color="#547FADA9" />
                    <SolidColorBrush x:Key="RetroTonalBorderBrush" Color="#667FADA9" />
                    <SolidColorBrush x:Key="RetroTonalInkBrush" Color="#FFCDE3E0" />
                    <!-- Vinyl placeholder parts (VinylDisc/SpinningVinyl):
                         the record stays near-black in both themes, like the
                         logo's; only the label follows the accent teal. -->
                    <SolidColorBrush x:Key="RetroVinylBrush" Color="#FF1B1B19" />
                    <SolidColorBrush x:Key="RetroVinylGrooveBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="RetroVinylLabelBrush" Color="#FF2C4A4F" />
                    <SolidColorBrush x:Key="RetroVinylHoleBrush" Color="#FF0E0E0D" />
                    <!-- Ink for content ON the accent fill (the spinning
                         marker's label stripe): dark ink on seafoam. -->
                    <SolidColorBrush x:Key="RetroOnAccentBrush" Color="#FF1E1E1C" />
                    <!-- Marker-disc detailing (SpinningVinyl): a soft cream
                         rim + brighter grooves so the record reads on dark
                         rows. Theme-stable like the record body. -->
                    <SolidColorBrush x:Key="RetroMarkerRimBrush" Color="#B3E9DCC0" />
                    <SolidColorBrush x:Key="RetroMarkerGrooveBrush" Color="#59FFFFFF" />

                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FF7FADA9" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF7FADA9" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FF7FADA9" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF8FBBB7" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF6E9995" />
                    <!-- Seafoam is a light fill: checked content flips to ink
                         (the default alt-chrome-white would wash out). -->
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF1E1E1C" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF1E1E1C" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF1E1E1C" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FF7FADA9" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FF8FBBB7" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FF7FADA9" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FF8FBBB7" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FF6E9995" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

                    <!-- Light-theme rework, 2026-07-27 (§13.2). The old light
                         half was the system near-white page + a pale seafoam
                         that sat only a few percent off it, so neither the nav
                         pane nor the play bar read as a surface, and a 1080p
                         TV showed one large flat white field. Three moves fix
                         it, and none of them touches dark:
                         (a) the ground becomes warm parchment (the logo's
                             cream, lightened) with a soft vertical wash, so
                             white is no longer the app's dominant colour;
                         (b) the chrome surface deepens far enough to read as
                             a card ON that parchment;
                         (c) the primary fill stops being aged tan — a brown
                             play/pause disc was the muddiest thing on screen
                             — and becomes the deep teal accent, which is
                             already the colour of every checked toggle and
                             radio, so the primary action finally matches the
                             rest of the light palette.
                         Tan survives where it earns its keep: the parchment
                         card frames and the first stripe of the motif. -->
                    <LinearGradientBrush x:Key="RetroPageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF7F3EA" Offset="0" />
                        <GradientStop Color="#FFEDE5D6" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="RetroWatermarkBrush" Color="#1F2F6B66" />
                    <SolidColorBrush x:Key="RetroPaneBorderBrush" Color="#66A08B63" />

                    <!-- Deep sleeve teal on light (seafoam lacks contrast there). -->
                    <Color x:Key="SystemAccentColor">#FF2F6B66</Color>
                    <Color x:Key="RetroAccentColor">#FF2F6B66</Color>
                    <SolidColorBrush x:Key="RetroAccentBrush" Color="#FF2F6B66" />
                    <!-- The "cream" role is the primary fill (play/pause,
                         progress line). On light it is the deep teal, not the
                         aged tan it used to be — see the note above. -->
                    <SolidColorBrush x:Key="RetroCreamBrush" Color="#FF2F6B66" />
                    <!-- Chrome surface (nav pane, play bar, controller badges):
                         deepened from #D9E5E2 so it separates from the
                         parchment. Still light enough that the near-black pane
                         text keeps ~10:1, and the 24-epx accent icons on it
                         stay above the 3:1 large-graphic line. -->
                    <SolidColorBrush x:Key="RetroSurfaceBrush" Color="#FFC4D9D3" />
                    <SolidColorBrush x:Key="RetroCardBorderBrush" Color="#99A08B63" />
                    <SolidColorBrush x:Key="RetroStripeBrush1" Color="#FF8A7550" />
                    <SolidColorBrush x:Key="RetroStripeBrush2" Color="#FF4E8783" />
                    <SolidColorBrush x:Key="RetroStripeBrush3" Color="#FF2F6B66" />
                    <!-- Ink on the (now teal) primary fill stays the pale cream. -->
                    <SolidColorBrush x:Key="RetroOnCreamBrush" Color="#FFF5EFE0" />
                    <!-- Detail-view action buttons — same roles as dark, on the
                         light palette: primary = the deep-teal fill with pale
                         cream ink; tonal = translucent deep-teal chip. -->
                    <SolidColorBrush x:Key="RetroPrimaryFillBrush" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="RetroPrimaryFillHoverBrush" Color="#FF3D7C76" />
                    <SolidColorBrush x:Key="RetroPrimaryFillPressedBrush" Color="#FF265853" />
                    <SolidColorBrush x:Key="RetroPrimaryInkBrush" Color="#FFF5EFE0" />
                    <SolidColorBrush x:Key="RetroTonalFillBrush" Color="#2E2F6B66" />
                    <SolidColorBrush x:Key="RetroTonalFillHoverBrush" Color="#452F6B66" />
                    <SolidColorBrush x:Key="RetroTonalFillPressedBrush" Color="#5C2F6B66" />
                    <SolidColorBrush x:Key="RetroTonalBorderBrush" Color="#8C2F6B66" />
                    <SolidColorBrush x:Key="RetroTonalInkBrush" Color="#FF2A5F5A" />
                    <SolidColorBrush x:Key="RetroVinylBrush" Color="#FF1B1B19" />
                    <SolidColorBrush x:Key="RetroVinylGrooveBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="RetroVinylLabelBrush" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="RetroVinylHoleBrush" Color="#FF0E0E0D" />
                    <!-- Light theme's accent is the deep teal, so its ink is pale. -->
                    <SolidColorBrush x:Key="RetroOnAccentBrush" Color="#FFF5EFE0" />
                    <SolidColorBrush x:Key="RetroMarkerRimBrush" Color="#B3E9DCC0" />
                    <SolidColorBrush x:Key="RetroMarkerGrooveBrush" Color="#59FFFFFF" />

                    <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF3D7C76" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF265853" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFF5EFE0" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFF5EFE0" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFF5EFE0" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FF3D7C76" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FF2F6B66" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FF3D7C76" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FF265853" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Items panels with a TIGHT realization cache (§11, 2026-08-13).

                 ItemsStackPanel/ItemsWrapGrid default to CacheLength="4.0" —
                 two viewports of realized containers above the visible one and
                 two below, so FIVE viewports exist at any moment. The console
                 measured exactly that ratio twice over: the queue overlay
                 realized ~85 containers for a ~17-row viewport, and playlist
                 detail realized all 95 rows for a ~19-row one. Virtualization
                 was working the whole time; the cache was the multiplier, and
                 a 95-row list is simply shorter than its own cache.

                 That matters here because a realized container in this app is
                 expensive: song rows carry a SpinningVinyl (a UserControl with
                 a storyboard) and a MenuFlyout of 8-12 items, all built when
                 the template inflates rather than when the menu opens.

                 1.0 rather than 0: one viewport of buffer either side is what
                 keeps fast scrolling from showing blank rows, which is the
                 trade-off this value is balancing. Do not raise it back to the
                 default without re-measuring — it costs ~5x the realized
                 containers, app-wide.

                 Applied to every items control that can hold a large
                 collection. Deliberately NOT applied to bounded ones (the
                 setup page's five recent servers, Search's capped "All"
                 sections), where the cache can never be the binding
                 constraint. -->
            <ItemsPanelTemplate x:Key="TightItemsStack">
                <ItemsStackPanel CacheLength="1.0" />
            </ItemsPanelTemplate>

            <!-- GridView's default panel, with the same cache. Orientation is
                 restated because declaring the panel replaces the default
                 instance: Horizontal means items flow across and wrap into new
                 rows, which is what the browse grids scroll vertically. -->
            <ItemsPanelTemplate x:Key="TightItemsWrapGrid">
                <ItemsWrapGrid Orientation="Horizontal" CacheLength="1.0" />
            </ItemsPanelTemplate>

            <!-- Requirement §13.3: one consistent open-source icon set.
                 Decision 2026-07-10: Fluent UI System Icons (MIT), shipped as
                 the Regular icon font; glyph codepoints come from the set's
                 official FluentSystemIcons-Regular.json map. -->
            <FontFamily x:Key="FluentIconFont">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>

            <!-- The set's Filled style (added 2026-07-15, console checkpoint
                 #4 follow-up): the favorite heart's starred state is a
                 color-filled heart, and the Regular font ships no filled
                 glyphs. Same set, same MIT license file. -->
            <FontFamily x:Key="FluentIconFilledFont">ms-appx:///Assets/Fonts/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>

            <!-- Detail-view action buttons (Play/Shuffle/Play next/Add to
                 queue on album/artist/playlist detail): the stock Button
                 chrome read as generic grey, off the retro palette. These two
                 styles restyle the fill/states without touching the default
                 focus visual (UseSystemFocusVisuals stays on, so the couch-
                 visible focus rect the §2/§13.1 controller UX depends on is
                 untouched). PointerOver/Pressed swap the fill to on-palette
                 hover/pressed brushes; Disabled dims the whole surface so the
                 artist-detail "fetching the pool" disable still reads. -->
            <Style x:Key="RetroPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource RetroPrimaryFillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource RetroPrimaryInkBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RetroPrimaryFillHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RetroPrimaryFillPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RetroTonalButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource RetroTonalFillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource RetroTonalInkBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource RetroTonalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RetroTonalFillHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RetroTonalFillPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nav icon size: the old NavigationViewItemIconBoxMargin
                 override that lived here was removed 2026-07-19 — root cause
                 finally understood: the template references that Thickness
                 from generic.xaml's GLOBAL scope, and resource lookups inside
                 a system template resolve at the template's own parse scope
                 first, so an app-level override is never consulted (on any
                 device — not a console quirk). Icons are enlarged by sizing
                 each item's IconBox Viewbox from code instead (MainPage). -->
        </ResourceDictionary>
    </Application.Resources>

</Application>
