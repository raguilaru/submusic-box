<Application
    x:Class="BoxSubMusic.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BoxSubMusic.App">

    <Application.Resources>
        <!-- Requirement §13.3: one consistent open-source icon set.
             Decision 2026-07-10: Fluent UI System Icons (MIT), shipped as the
             Regular icon font; glyph codepoints come from the set's official
             FluentSystemIcons-Regular.json map. -->
        <FontFamily x:Key="FluentIconFont">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>

        <!-- 10-ft nav pane icons (console findings 2026-07-14/15): the OS
             NavigationView left-pane template puts each item's icon in a
             Viewbox whose size is 40 epx (hardcoded row height) minus this
             margin — 12+12 vertical by default, i.e. a 16 epx icon.
             FontIcon.FontSize is a no-op (Viewbox rescales), and the WinUI
             resource NavigationViewItemOnLeftIconBoxHeight does not exist
             in the OS generic.xaml (verified in the 26100 SDK). 6+6 gives
             28 epx icons, pairing with the 20 epx item text in MainPage. -->
        <Thickness x:Key="NavigationViewItemIconBoxMargin">10,6,16,6</Thickness>
    </Application.Resources>

</Application>
