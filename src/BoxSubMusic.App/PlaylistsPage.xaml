<Page
    x:Class="BoxSubMusic.App.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Playlists browse (Slice 09, requirements §7.4): grid by default with a
         list alternate and the shared always-visible view-mode toggle (§13.5).
         Each tile's artwork is composed client-side from the playlist's
         constituent album covers (up to four distinct, single cover when one
         album), loaded lazily per card after the grid is on screen. Read-only
         for v1 (decision 2026-07-13): cards are focusable but do not open a
         detail/playback view yet; a connection/auth failure is a page-level
         error with Retry (§3). -->
    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + always-visible grid/list toggle (§13.5). -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <TextBlock
                Text="Playlists"
                FontSize="48"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <controls:ViewModeToggle
                x:Name="ViewModeToggle"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ModeChanged="ViewModeToggle_Changed" />
        </Grid>

        <!-- Read-only for v1: opening a playlist / playback arrives with a
             later slice once the queue infrastructure exists. -->
        <TextBlock
            Grid.Row="1"
            Text="Opening a playlist and playback arrive in a later update."
            FontSize="16"
            Opacity="0.6"
            Margin="0,0,0,20" />

        <!-- Content states share row 2; only one is visible at a time. -->
        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                Text="This server has no playlists."
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <!-- Default mode: grid. Cards are focusable but inert in v1. -->
            <GridView
                x:Name="PlaylistsGrid"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,20,20" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistCard">
                        <StackPanel Width="200" Spacing="8">
                            <Grid Width="200" Height="200" CornerRadius="8">
                                <!-- Placeholder shows while the composite loads
                                     and when a playlist has no artwork. Same
                                     official Fluent codepoint as the Playlists
                                     nav item (§13.3: never invent codepoints). -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <FontIcon
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xF4EE;"
                                        FontSize="64"
                                        Opacity="0.4" />
                                </Border>

                                <!-- Single-album playlist: one full cover (§7.4). -->
                                <Image Stretch="UniformToFill" Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind SingleCover, Mode=OneWay}" DecodePixelWidth="400" />
                                    </Image.Source>
                                </Image>

                                <!-- Multi-album playlist: adaptive composite
                                     (§7.4) — the bound row spans let 2 covers
                                     fill full-height halves and 3 covers use a
                                     full-height left + stacked right, so no
                                     cell is ever empty; 4 covers form a 2×2. -->
                                <Grid Visibility="{x:Bind CompositeVisibility, Mode=OneWay}"
                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="{x:Bind Cover0RowSpan, Mode=OneWay}" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover0, Mode=OneWay}" DecodePixelWidth="200" />
                                        </Image.Source>
                                    </Image>
                                    <Image Grid.Row="0" Grid.Column="1" Grid.RowSpan="{x:Bind Cover1RowSpan, Mode=OneWay}" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover1, Mode=OneWay}" DecodePixelWidth="200" />
                                        </Image.Source>
                                    </Image>
                                    <Image Grid.Row="1" Grid.Column="0" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover2, Mode=OneWay}" DecodePixelWidth="200" />
                                        </Image.Source>
                                    </Image>
                                    <Image Grid.Row="1" Grid.Column="1" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover3, Mode=OneWay}" DecodePixelWidth="200" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Alternate mode: list. -->
            <ListView
                x:Name="PlaylistsList"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistCard">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Grid Width="56" Height="56" CornerRadius="6">
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <FontIcon
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xF4EE;"
                                        FontSize="24"
                                        Opacity="0.4" />
                                </Border>
                                <Image Stretch="UniformToFill" Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind SingleCover, Mode=OneWay}" DecodePixelWidth="112" />
                                    </Image.Source>
                                </Image>
                                <Grid Visibility="{x:Bind CompositeVisibility, Mode=OneWay}"
                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="{x:Bind Cover0RowSpan, Mode=OneWay}" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover0, Mode=OneWay}" DecodePixelWidth="56" />
                                        </Image.Source>
                                    </Image>
                                    <Image Grid.Row="0" Grid.Column="1" Grid.RowSpan="{x:Bind Cover1RowSpan, Mode=OneWay}" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover1, Mode=OneWay}" DecodePixelWidth="56" />
                                        </Image.Source>
                                    </Image>
                                    <Image Grid.Row="1" Grid.Column="0" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover2, Mode=OneWay}" DecodePixelWidth="56" />
                                        </Image.Source>
                                    </Image>
                                    <Image Grid.Row="1" Grid.Column="1" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind Cover3, Mode=OneWay}" DecodePixelWidth="56" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
