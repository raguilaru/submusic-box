<Page
    x:Class="BoxSubMusic.App.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BoxSubMusic.App.Models"
    xmlns:controls="using:BoxSubMusic.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Playlists browse (Slice 09, requirements §7.4): grid by default with a
         list alternate and the shared always-visible view-mode toggle (§13.5).
         Each tile's artwork is composed client-side from the playlist's
         constituent album covers (up to four distinct, single cover when one
         album), loaded lazily per card after the grid is on screen. Tiles open
         the playlist detail/playback view; editing stays out of v1 (decision
         2026-07-13). A connection/auth failure is a page-level error with
         Retry (§3). -->
    <Grid Padding="48,36,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + always-visible grid/list toggle (§13.5). -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock
                    Text="Playlists"
                    FontSize="48"
                    FontWeight="SemiBold" />
                <controls:RetroStripes Width="150" HorizontalAlignment="Left" />
            </StackPanel>
            <controls:ViewModeToggle
                x:Name="ViewModeToggle"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ModeChanged="ViewModeToggle_Changed" />
        </Grid>

        <!-- Content states share row 1; only one is visible at a time. -->
        <Grid Grid.Row="1">
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyText"
                Visibility="Collapsed"
                Text="This server has no playlists."
                FontSize="24"
                Opacity="0.7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="ConnectErrorPanel"
                Visibility="Collapsed"
                Spacing="16"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="ConnectErrorText"
                    FontSize="22"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <Button
                    x:Name="ConnectRetryButton"
                    Content="Retry"
                    FontSize="20"
                    Padding="40,10"
                    HorizontalAlignment="Center"
                    Click="ConnectRetryButton_Click" />
            </StackPanel>

            <!-- Default mode: grid. Cards open the playlist detail view. -->
            <GridView
                x:Name="PlaylistsGrid"
                XYFocusUp="{x:Bind ViewModeToggle.FocusTarget}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Playlists_ItemClick"
                ContextRequested="Playlists_ContextRequested"
                Padding="0,0,0,24">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,20,20" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistCard">
                        <StackPanel Width="200" Spacing="8">
                            <StackPanel.ContextFlyout>
                                <!-- Container queue edits (2026-07-18): the
                                     playlist's songs are fetched on demand.
                                     Gamepad Menu button routed via the
                                     view-level redirect (console-verified). -->
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="Play"
                                        Tag="{x:Bind}"
                                        Click="PlaylistPlay_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Play next"
                                        Tag="{x:Bind}"
                                        Click="PlaylistPlayNext_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Add to queue"
                                        Tag="{x:Bind}"
                                        Click="PlaylistAddToQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Grid Width="200" Height="200" CornerRadius="8" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                                <!-- Placeholder shows while the composite loads
                                     and when a playlist has no artwork. Same
                                     official Fluent codepoint as the Playlists
                                     nav item (§13.3: never invent codepoints). -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <FontIcon
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xF4EE;"
                                        FontSize="64"
                                        Opacity="0.4" />
                                </Border>

                                <!-- Covers render as ImageBrush fills, not Image
                                     elements: Image's UniformToFill crops from
                                     the top-left, while a brush center-crops —
                                     required so partial cells (halves, strips)
                                     show the middle of the artwork. -->

                                <!-- Single-album playlist: one full cover (§7.4). -->
                                <Rectangle Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                    <Rectangle.Fill>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage UriSource="{x:Bind SingleCover, Mode=OneWay}" DecodePixelWidth="400" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!-- Multi-album playlist: adaptive composite
                                     (§7.4) — the bound row spans let 2 covers
                                     fill full-height halves and 3 covers use a
                                     full-height left + stacked right, so no
                                     cell is ever empty; 4 covers form a 2×2. -->
                                <Grid Visibility="{x:Bind CompositeVisibility, Mode=OneWay}"
                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="{x:Bind Cover0RowSpan, Mode=OneWay}">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover0, Mode=OneWay}" DecodePixelWidth="200" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Grid.Row="0" Grid.Column="1" Grid.RowSpan="{x:Bind Cover1RowSpan, Mode=OneWay}">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover1, Mode=OneWay}" DecodePixelWidth="200" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Grid.Row="1" Grid.Column="0">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover2, Mode=OneWay}" DecodePixelWidth="200" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Grid.Row="1" Grid.Column="1">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover3, Mode=OneWay}" DecodePixelWidth="200" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Alternate mode: list. -->
            <ListView
                x:Name="PlaylistsList"
                XYFocusUp="{x:Bind ViewModeToggle.FocusTarget}"
                Visibility="Collapsed"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Playlists_ItemClick"
                ContextRequested="Playlists_ContextRequested">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistCard">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="Play"
                                        Tag="{x:Bind}"
                                        Click="PlaylistPlay_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF606;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Play next"
                                        Tag="{x:Bind}"
                                        Click="PlaylistPlayNext_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xE861;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Text="Add to queue"
                                        Tag="{x:Bind}"
                                        Click="PlaylistAddToQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource FluentIconFont}" Glyph="&#xF7A8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Grid Width="56" Height="56" CornerRadius="6" BorderBrush="{ThemeResource RetroCardBorderBrush}" BorderThickness="1">
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <FontIcon
                                        FontFamily="{StaticResource FluentIconFont}"
                                        Glyph="&#xF4EE;"
                                        FontSize="24"
                                        Opacity="0.4" />
                                </Border>
                                <!-- ImageBrush (not Image) so partial cells
                                     center-crop; see the grid template note. -->
                                <Rectangle Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                    <Rectangle.Fill>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <BitmapImage UriSource="{x:Bind SingleCover, Mode=OneWay}" DecodePixelWidth="112" />
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Visibility="{x:Bind CompositeVisibility, Mode=OneWay}"
                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Grid.RowSpan="{x:Bind Cover0RowSpan, Mode=OneWay}">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover0, Mode=OneWay}" DecodePixelWidth="56" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Grid.Row="0" Grid.Column="1" Grid.RowSpan="{x:Bind Cover1RowSpan, Mode=OneWay}">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover1, Mode=OneWay}" DecodePixelWidth="56" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Grid.Row="1" Grid.Column="0">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover2, Mode=OneWay}" DecodePixelWidth="56" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle Grid.Row="1" Grid.Column="1">
                                        <Rectangle.Fill>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind Cover3, Mode=OneWay}" DecodePixelWidth="56" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="22" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="16" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
